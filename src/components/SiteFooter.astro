---
import Barcode from './print/Barcode.astro'
import MonoLabel from './print/MonoLabel.astro'
import Wrap from './primitives/Wrap.astro'
---

<footer class="site">
  <Wrap>
    <div class="foot-grid">
      <div>
        <div class="foot-brand">
          exhale
          <div class="fb-sub">
            The personal index of Pierrick Bignet.<br />
            Engineer by trade, artist by default.<br />
            Built on paper, light and dots.
          </div>
        </div>
      </div>

      <div class="foot-col">
        <h4>Read</h4>
        <a href="/writing">Writing</a>
        <a href="/guides">Field Guides</a>
        <a href="/projects">Projects</a>
        <a href="/now">Now</a>
      </div>

      <div class="foot-col">
        <h4>Around</h4>
        <a href="/about">About</a>
        <a href="/setup">Setup</a>
        <a href="/photos">Photos</a>
        <a href="/travel" title="Section en cours de construction">Travel ⌁</a>
      </div>

      <div class="foot-right">
        <Barcode label="PB · 2026 · 45.76N 4.83E · ∞" />
        <div class="foot-credit">
          <MonoLabel>
            SET IN ANTON · ARCHIVO<br />
            SPACE MONO · NEWSREADER
          </MonoLabel>
        </div>
      </div>
    </div>
  </Wrap>
</footer>

<style>
  .site {
    margin-top: clamp(70px, 9vw, 120px);
    border-top: 2px solid var(--ink);
    padding: 30px 0 56px;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr auto;
    gap: 30px;
    align-items: start;
  }

  .foot-brand {
    font-family: var(--display);
    font-size: 40px;
    line-height: 0.9;
    letter-spacing: 0.02em;
  }

  .fb-sub {
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: 0.05em;
    color: var(--ink-2);
    margin-top: 12px;
    line-height: 1.7;
  }

  .foot-col h4 {
    font-family: var(--mono);
    font-size: var(--fs-tag);
    letter-spacing: var(--tr-tag);
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 12px;
  }
  .foot-col a {
    display: block;
    font-family: var(--mono);
    font-size: var(--fs-data);
    color: var(--ink-2);
    padding: 3px 0;
    transition: color 0.2s;
  }
  .foot-col a:hover { color: var(--accent); }

  .foot-right { text-align: right; }
  /* l'espacement appartient au conteneur, pas au MonoLabel (cf. PIPELINE §4.4) */
  .foot-credit { margin-top: var(--space-md); }

  @media (max-width: 880px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
