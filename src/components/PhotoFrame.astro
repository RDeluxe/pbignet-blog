---
interface Props {
  src: string
  alt: string
  caption: string
  number: string
  ratio?: 'tall' | 'wide'
}

const { src, alt, caption, number, ratio = 'tall' } = Astro.props
---

<div class:list={['pframe', ratio]}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  <div class="pc">
    <span>{caption}</span>
    <span>{number}</span>
  </div>
</div>

<style>
  .pframe {
    position: relative;
    overflow: hidden;
    background: var(--photo-ground);
    border: 1px solid var(--line);
  }
  .pframe.tall { aspect-ratio: 3 / 4; }
  .pframe.wide { aspect-ratio: 4 / 5; }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pc {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: var(--fs-tag);
    /* TODO token: 0.08em → --tr-… ? (absent de l'échelle ; déjà en dur dans CollCard) */
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cover-ink-light);
    background: linear-gradient(transparent, rgba(var(--photo-scrim-rgb), 0.7));
    /* TODO token: 18px (= --space-head, réservé aux en-têtes) et 8px absents de l'échelle
       générique — seul le 10px latéral est tokenisé */
    padding: 18px var(--space-off-10) 8px;
  }
</style>
