---
/**
 * Quote — a quote to READ, in the run of the text: every Markdown `> …`, and
 * `{% quote source="…" %}` when the quote names where it comes from.
 *
 * Body size, Newsreader italic, set in by one cell: neutral until Pierrick picks a form.
 * The display size belongs to `PullQuote` (`{% pullquote %}`) alone: a Markdown quote used to
 * get it, and a four-line quote with a bare URL came out 264px tall (critique 2026-11-02,
 * n° 6). Never a left accent bar (Design Notes, July 2026).
 */
interface Props {
  /** where the quote comes from, in the furniture's mono under the quote */
  source?: string
  /** the source's address, when it has one */
  href?: string
}

const { source, href } = Astro.props
---

<figure class="quote">
  <blockquote cite={href}><slot /></blockquote>
  {source && (
    <figcaption class="src">
      {href ? <a href={href}>{source}</a> : source}
    </figcaption>
  )}
</figure>

<style>
  /* A quote to read, kept neutral until a form is chosen (five tracks were shown on
     2026-11-02): body size, Newsreader italic, set in by one cell, no ornament. The
     display size belongs to PullQuote alone. */
  .quote {
    margin: 2em 0;
    padding-left: var(--cell);
  }

  blockquote {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
  }
  /* the slot is the quote's own paragraphs and lists, rendered by Markdoc */
  blockquote :global(> *) { margin: 0 0 0.8em; }
  blockquote :global(> :last-child) { margin-bottom: 0; }
  blockquote :global(ul),
  blockquote :global(ol) { padding-left: 1.2em; }

  .src {
    margin-top: var(--space-s);
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tr-data);
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .src a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media print {
    .quote { break-inside: avoid; }
  }
</style>
