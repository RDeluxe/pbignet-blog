---
/**
 * Quote — a quote to READ, in the run of the text: every Markdown `> …`, and
 * `{% quote source="…" %}` when the quote names where it comes from.
 *
 * Body size, roman Newsreader, set in behind a halftone opening mark. The display size
 * belongs to `PullQuote` (`{% pullquote %}`) alone: a Markdown quote used to
 * get it, and a four-line quote with a bare URL came out 264px tall (critique 2026-11-02,
 * n° 6). Never a left accent bar (Design Notes, July 2026).
 */
interface Props {
  /** where the quote comes from, in the furniture's mono under the quote */
  source?: string
  /** the source's address, when it has one */
  href?: string
}

const { source, href } = Astro.props
---

<figure class="quote">
  <blockquote cite={href}><slot /></blockquote>
  {source && (
    <figcaption class="src">
      {href ? <a href={href}>{source}</a> : source}
    </figcaption>
  )}
</figure>

<style>
  /* A quote to read: body size, roman Newsreader, full ink. The display size and the
     italic between two rules belong to PullQuote alone. */
  .quote {
    position: relative;
    margin: 2em 0;
    padding-left: calc(2.5 * var(--cell));
  }

  blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink);
  }
  /* the slot is the quote's own paragraphs and lists, rendered by Markdoc */
  blockquote :global(> *) { margin: 0 0 0.8em; }
  blockquote :global(> :last-child) { margin-bottom: 0; }
  blockquote :global(ul),
  blockquote :global(ol) { padding-left: 1.2em; }

  /* the opening mark, printed as a halftone screen in the page ink: the hero's move (a
     texture through the letter) at the scale of a quote. French posts open on « . */
  .quote::before {
    content: '\201C';
    position: absolute;
    top: -0.12em;
    left: -0.04em;
    font-family: var(--serif);
    font-weight: 700;
    font-size: calc(5 * var(--cell));
    line-height: 1;
    color: transparent;
    background-image: radial-gradient(var(--accent) 1.5px, transparent 2px);
    background-size: 5px 5px;
    background-clip: text;
    -webkit-background-clip: text;
    pointer-events: none;
  }
  .quote:lang(fr)::before { content: '\00AB'; top: 0.02em; }

  .src {
    margin-top: var(--space-s);
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tr-data);
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .src a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media print {
    .quote { break-inside: avoid; }
  }
</style>
