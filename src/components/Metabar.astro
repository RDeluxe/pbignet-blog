---
import { formatMonth } from '../lib/date'
import { getPosts } from '../lib/posts'

interface Props {
  /** when the index last filed something: the latest post's month, never a frozen value */
  date?: string
  location?: string
}

const [latest] = await getPosts()
const { date = latest ? formatMonth(latest.post.data.pubDate) : '', location = 'Lyon, FR' } = Astro.props
---

<!-- Only real data (header review, 2026-11-02, distill): « Title · Personal Index » and
     « Edition · Vol. ∞ » described the format, not the index; they went. -->
<div class="metabar">
  <div class="m"><div class="k">Filed by</div><div class="v">P. Bignet</div></div>
  <div class="m"><div class="k">Location</div><div class="v">{location}</div></div>
  <div class="m"><div class="k">Last filed</div><div class="v">{date}</div></div>
  <a class="brand" href="/">exhale</a>
</div>

<style>
  .metabar {
    display: grid;
    grid-template-columns: repeat(3, 1fr) auto;
    /* TODO token: 18px → --space-… ? (vaut --space-head, réservé aux en-têtes de section) */
    gap: 0 var(--space-ml);
    border-bottom: 2px solid var(--ink);
    /* TODO token: 14px / 11px → --space-… ? (absents de l'échelle) */
    padding: var(--space-sm) 0 11px;
    align-items: end;
  }
  .m .k {
    font-family: var(--mono);
    font-size: var(--fs-tag);
    /* TODO token: 0.12em → --tr-… ? (entre --tr-data 0.1em et --tr-tag 0.14em) */
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .m .v {
    font-family: var(--mono);
    font-size: var(--fs-data);
    color: var(--ink);
    /* TODO token: 3px → --space-… ? (absent de l'échelle ; déjà en dur dans Tag/SiteFooter) */
    margin-top: 3px;
  }
  .brand {
    font-family: var(--display);
    /* TODO token: le logotype « exhale » n'a pas d'échelle à lui → --fs-brand / --tr-brand ?
       (SiteFooter porte la même marque en 40px / 0.02em, également en dur) */
    font-size: var(--fs-brand-sm);
    letter-spacing: var(--tr-brand);
    line-height: 1;
    text-align: right;
  }

  /* narrow: the brand on its own row above the three fields, which keep one row */
  @media (max-width: 880px) {
    .metabar {
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
      row-gap: var(--space-s);
    }
    .brand { grid-row: 1; grid-column: 1 / -1; text-align: left; }
  }
</style>
