---
interface Props {
  date?: string
  location?: string
}

const { date = '02.06.26', location = 'Lyon, FR' } = Astro.props
---

<div class="metabar">
  <div class="m"><div class="k">Title</div><div class="v">Personal Index</div></div>
  <div class="m"><div class="k">Date</div><div class="v">{date}</div></div>
  <div class="m"><div class="k">Edition</div><div class="v">Vol. ∞</div></div>
  <div class="m"><div class="k">Filed by</div><div class="v">P. Bignet</div></div>
  <div class="m"><div class="k">Location</div><div class="v">{location}</div></div>
  <div class="brand">·<span class="dot">●</span>paper</div>
</div>

<style>
  .metabar {
    display: grid;
    grid-template-columns: repeat(5, 1fr) auto;
    gap: 0 18px;
    border-bottom: 2px solid var(--ink);
    padding: 14px 0 11px;
    align-items: end;
  }
  .m .k {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .m .v {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink);
    margin-top: 3px;
  }
  .brand {
    font-family: var(--display);
    font-size: 26px;
    letter-spacing: 0.02em;
    line-height: 1;
    text-align: right;
  }
  .dot { color: var(--accent); }

  @media (max-width: 880px) {
    .metabar { grid-template-columns: 1fr 1fr; }
    .brand { grid-column: span 2; text-align: left; }
  }
</style>
