---
interface Props {
  date?: string
  location?: string
}

const { date = '02.06.26', location = 'Lyon, FR' } = Astro.props
---

<div class="metabar">
  <div class="m"><div class="k">Title</div><div class="v">Personal Index</div></div>
  <div class="m"><div class="k">Date</div><div class="v">{date}</div></div>
  <div class="m"><div class="k">Edition</div><div class="v">Vol. ∞</div></div>
  <div class="m"><div class="k">Filed by</div><div class="v">P. Bignet</div></div>
  <div class="m"><div class="k">Location</div><div class="v">{location}</div></div>
  <div class="brand">exhale</div>
</div>

<style>
  .metabar {
    display: grid;
    grid-template-columns: repeat(5, 1fr) auto;
    /* TODO token: 18px → --space-… ? (vaut --space-head, réservé aux en-têtes de section) */
    gap: 0 18px;
    border-bottom: 2px solid var(--ink);
    /* TODO token: 14px / 11px → --space-… ? (absents de l'échelle) */
    padding: 14px 0 11px;
    align-items: end;
  }
  .m .k {
    font-family: var(--mono);
    font-size: var(--fs-tag);
    /* TODO token: 0.12em → --tr-… ? (entre --tr-data 0.1em et --tr-tag 0.14em) */
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .m .v {
    font-family: var(--mono);
    font-size: var(--fs-data);
    color: var(--ink);
    /* TODO token: 3px → --space-… ? (absent de l'échelle ; déjà en dur dans Tag/SiteFooter) */
    margin-top: 3px;
  }
  .brand {
    font-family: var(--display);
    /* TODO token: le logotype « exhale » n'a pas d'échelle à lui → --fs-brand / --tr-brand ?
       (SiteFooter porte la même marque en 40px / 0.02em, également en dur) */
    font-size: var(--fs-brand-sm);
    letter-spacing: var(--tr-brand);
    line-height: 1;
    text-align: right;
  }

  @media (max-width: 880px) {
    .metabar { grid-template-columns: 1fr 1fr; }
    .brand { grid-column: span 2; text-align: left; }
  }
</style>
