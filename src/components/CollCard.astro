---
import Tag from './Tag.astro'

interface Props {
  tag: string
  tagAccent?: boolean
  title: string
  description: string
  footer: string
  href: string
  /**
   * La carte porte son propre cadre (défaut). Passer `false` dans une
   * `<Grid gap="hairline">` : c'est la grille qui fournit les filets, et le fond doit
   * alors être opaque pour masquer celui de la grille.
   */
  bordered?: boolean
}

const { tag, tagAccent = false, title, description, footer, href, bordered = true } = Astro.props
---

<a class="coll" href={href} data-bordered={bordered ? 'on' : 'off'}>
  <Tag accent={tagAccent}>{tag}</Tag>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="coll-foot">{footer} →</span>
</a>

<style>
  .coll {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }
  .coll[data-bordered='on'] {
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 2%, transparent);
  }
  .coll[data-bordered='off'] {
    border: none;
    background: var(--paper);
  }
  .coll:hover { transform: translateY(-3px); }
  .coll[data-bordered='on']:hover { border-color: var(--ink-2); }

  h3 {
    margin: 0;
    font-family: var(--sans);
    font-weight: var(--w-bold);
    font-size: var(--fs-card-title);
    letter-spacing: -0.01em;
  }

  p {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--fs-body-xs);
    color: var(--ink-2);
    line-height: var(--lh-body-tight);
  }

  .coll-foot {
    margin-top: auto;
    font-family: var(--mono);
    font-size: var(--fs-label);
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }
</style>
