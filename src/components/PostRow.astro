---
import { formatMonth } from '../lib/date'
import Tag from './Tag.astro'

interface Props {
  index: string
  tag: string
  tagAccent?: boolean
  title: string
  description: string
  readTime: number
  pubDate: Date
  href: string
  /** language of the post: a post in one language only says so under its date when it
   *  is not the reader's (base.css hides the mark that matches `html[data-lang]`) */
  lang?: 'en' | 'fr'
  /** one version of a translated pair: the list carries both rows, and only the reader's
   *  language shows (base.css, `[data-pair-lang]`) */
  paired?: boolean
  /** the title's level in the page's outline: h2 under the page's h1, h3 under a section head */
  titleAs?: 'h2' | 'h3'
}

const { index, tag, tagAccent = false, title, description, readTime, pubDate, href, lang = 'en', paired = false, titleAs: Title = 'h3' } = Astro.props
---

<a class="post" href={href} hreflang={lang} data-pair-lang={paired ? lang : undefined}>
  <span class="idx">{index}</span>
  <div class="body" lang={lang}>
    <span class="ptag"><Tag accent={tagAccent}>{tag}</Tag></span>
    <Title class="ptitle">{title}</Title>
    <p class="pdesc">{description}</p>
  </div>
  <span class="pmeta">
    <span>{readTime} MIN</span>
    <span>{formatMonth(pubDate)}</span>
    {!paired && <span data-lang-mark={lang}>{lang.toUpperCase()}</span>}
  </span>
</a>

<style>
  /* la ligne garde son glissement de 14px au hover ; la flèche a été retirée
     (Design Notes, audit des boîtes, juillet 2026 : « .post keeps its 14px slide,
     hover arrow removed »). */
  .post {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: var(--rhythm-row);
    align-items: baseline;
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--line);
    position: relative;
    transition: transform 0.25s ease;
  }
  .post:last-of-type { border-bottom: 1px solid var(--line); }
  /* a list ending on a pair: either of its two rows may be the one shown, and close it */
  .post[data-pair-lang]:nth-last-of-type(2):has(+ .post[data-pair-lang]:last-of-type) {
    border-bottom: 1px solid var(--line);
  }
  .post:hover { transform: translateX(14px); }

  .idx {
    font-family: var(--mono);
    font-size: var(--fs-data);
    color: var(--ink-3);
    padding-top: var(--space-optical-6);
  }

  .ptitle {
    margin: 0;
    font-family: var(--sans);
    font-weight: var(--w-semibold);
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    letter-spacing: var(--tr-title);
    text-wrap: balance;
  }

  .pmeta {
    display: flex;
    flex-direction: column;
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--ink-2);
    text-align: right;
    white-space: nowrap;
    line-height: var(--lh-body-tight);
  }

  .pdesc {
    font-family: var(--serif);
    font-size: var(--fs-body-sm);
    color: var(--ink-2);
    margin: var(--space-xs) 0 0;
    max-width: var(--measure-desc);
    line-height: var(--lh-body-tight);
  }

  /* Narrow: the three columns left the title 198px wide, broken over 3-4 lines (critique
     2026-11-02, n° 19). The number and the meta move onto the tag's line, and the title and
     its description take the full width below. */
  @media (max-width: 520px) {
    .post {
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'idx tag meta'
        'title title title'
        'desc desc desc';
      gap: var(--space-xs) var(--space-s);
      align-items: center;
    }
    .body { display: contents; }
    .idx { grid-area: idx; padding-top: 0; }
    .ptag { grid-area: tag; }
    .ptitle { grid-area: title; margin-top: var(--space-xs); }
    .pdesc { grid-area: desc; margin-top: 0; }
    .pmeta {
      grid-area: meta;
      flex-direction: row;
      gap: var(--space-s);
    }
  }
</style>
