---
import Tag from './Tag.astro'

interface Props {
  index: string
  tag: string
  tagAccent?: boolean
  title: string
  description: string
  readTime: number
  pubDate: Date
  href: string
}

const { index, tag, tagAccent = false, title, description, readTime, pubDate, href } = Astro.props

const month = pubDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }).toUpperCase()
---

<a class="post" href={href}>
  <span class="idx">{index}</span>
  <span>
    <Tag accent={tagAccent}>{tag}</Tag>
    <div class="ptitle">{title}</div>
    <div class="pdesc">{description}</div>
  </span>
  <span class="pmeta">{readTime} MIN<br />{month}</span>
</a>

<style>
  /* la ligne garde son glissement de 14px au hover ; la flèche a été retirée
     (Design Notes, audit des boîtes, juillet 2026 : « .post keeps its 14px slide,
     hover arrow removed »). */
  .post {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: var(--rhythm-row);
    align-items: baseline;
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--line);
    position: relative;
    transition: transform 0.25s ease;
  }
  .post:last-of-type { border-bottom: 1px solid var(--line); }
  .post:hover { transform: translateX(14px); }

  .idx {
    font-family: var(--mono);
    font-size: var(--fs-data);
    color: var(--ink-3);
    padding-top: var(--space-optical-6);
  }

  .ptitle {
    font-family: var(--sans);
    font-weight: var(--w-semibold);
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    letter-spacing: var(--tr-title);
    text-wrap: balance;
  }

  .pmeta {
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--ink-2);
    text-align: right;
    white-space: nowrap;
    line-height: var(--lh-body-tight);
  }

  .pdesc {
    font-family: var(--serif);
    font-size: var(--fs-body-sm);
    color: var(--ink-2);
    margin-top: var(--space-xs);
    max-width: var(--measure-desc);
    line-height: var(--lh-body-tight);
  }

</style>
