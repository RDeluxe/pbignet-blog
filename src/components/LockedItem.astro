---
/**
 * LockedItem — sections the index announces but has not built yet (Pierrick kept them
 * visible at lot 2). Not links, and they say so: the labels in the quiet ink, then ONE
 * mono « soon » mark for the run, leading it as its label (trailing a single entry). One mark per entry made six in a row in the nav, a
 * roadmap rather than a way around (header review, 2026-11-02); the footer still passes
 * one label at a time.
 *
 * Size and tracking come from where it sits (nav, footer); it owns the ink and the mark.
 */
interface Props {
  labels: string[]
}

const { labels } = Astro.props
---

<span class="lock" data-run={labels.length > 1 ? 'on' : 'off'}>
  {labels.length > 1 && <span class="soon">soon</span>}
  {labels.map(label => (
    <span>{label}{labels.length === 1 && <span class="soon">soon</span>}</span>
  ))}
</span>

<style>
  /* the run has no box of its own: its labels flow in the parent's row, with its gaps */
  .lock { display: contents; }
  /* leading a run, the mark sits on the baseline as the run's label */
  .lock[data-run='on'] > .soon {
    margin-left: 0;
    vertical-align: baseline;
    align-self: center;
  }
  .lock > span {
    color: var(--ink-3);
    cursor: default;
  }
  .soon {
    margin-left: 0.5em;
    vertical-align: 0.2em;
    font-family: var(--mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-micro);
    text-transform: uppercase;
  }
</style>
