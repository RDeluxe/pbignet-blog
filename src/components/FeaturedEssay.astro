---
interface Props {
  number: string
  location: string
  src: string
  alt: string
  word: string
  shotOn: string
  readTime: string
  href: string
}

const { number, location, src, alt, word, shotOn, readTime, href } = Astro.props
---

<a class="feature" href={href}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  <span class="ftag">№ {number} · {location}</span>
  <h2 class="fword">{word}</h2>
  <div class="fmeta"><b>SHOT ON</b> {shotOn}<br />{readTime} MIN READ →</div>
</a>

<style>
  .feature {
    position: relative;
    display: block;
    height: min(64vh, 560px);
    overflow: hidden;
    background: #2a2620;
  }

  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
  }

  .ftag {
    position: absolute;
    z-index: 2;
    top: 18px;
    left: 18px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f0e9d8;
    background: rgba(20, 18, 12, 0.5);
    padding: 4px 9px;
  }

  .fword {
    position: absolute;
    z-index: 2;
    left: 3%;
    bottom: 4%;
    margin: 0;
    font-family: var(--display);
    font-size: clamp(70px, 13vw, 180px);
    line-height: 0.8;
    text-transform: lowercase;
    color: #f1ead8;
    text-shadow: 0.045em 0.045em 0 #7a2414;
    letter-spacing: 0.005em;
  }

  .fmeta {
    position: absolute;
    z-index: 2;
    right: 4%;
    bottom: 8%;
    text-align: right;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #36281f;
    line-height: 1.7;
  }
  .fmeta b { color: #ad3318; }
</style>
