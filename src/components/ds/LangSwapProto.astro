---
/**
 * THROWAWAY prototype (i18n review, 2026-11-05): the per-post language switch and three
 * candidate animations for the content swap. Lives under /ds/ only; deleted once Pierrick
 * has picked. Not a component of the system: do not import it elsewhere.
 */
---

<div class="proto-panel" role="group" aria-label="Prototype controls">
  <span class="pp-k">Animation</span>
  <button type="button" data-variant="trame" aria-pressed="true">A · Trame</button>
  <button type="button" data-variant="passe" aria-pressed="false">B · Passe</button>
  <button type="button" data-variant="repere" aria-pressed="false">C · Repérage</button>
  <label class="pp-rm"><input type="checkbox" id="pp-rm" /> reduced-motion</label>
</div>

<script>
const BAYER4 = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5]
const CELL = 3 // px per dither dot, like the cover recipes

const fromUrl = new URLSearchParams(location.search).get('anim')
let variant = fromUrl && ['trame', 'passe', 'repere'].includes(fromUrl) ? fromUrl : 'trame'
const forceReduced = document.getElementById('pp-rm') as HTMLInputElement
const reduced = (): boolean => forceReduced.checked || matchMedia('(prefers-reduced-motion: reduce)').matches

document.querySelectorAll('.proto-panel [data-variant]').forEach(o => o.setAttribute('aria-pressed', String((o as HTMLElement).dataset.variant === variant)))
document.querySelectorAll<HTMLButtonElement>('.proto-panel [data-variant]').forEach((b) => {
  b.addEventListener('click', () => {
    variant = b.dataset.variant!
    document.querySelectorAll('.proto-panel [data-variant]').forEach(o => o.setAttribute('aria-pressed', String(o === b)))
  })
})

/** one 4×4 Bayer tile per level: dot on where bayer < level (or >= level when inverted) */
function bayerTile(level: number, invert: boolean): string {
  const c = document.createElement('canvas')
  c.width = c.height = 4 * CELL
  const g = c.getContext('2d')!
  for (let i = 0; i < 16; i++) {
    const on = invert ? BAYER4[i] >= level : BAYER4[i] < level
    if (on)
      g.fillRect((i % 4) * CELL, Math.floor(i / 4) * CELL, CELL, CELL)
  }
  return `url(${c.toDataURL()})`
}
const tiles = Array.from({ length: 17 }, (_, l) => [bayerTile(l, false), bayerTile(l, true)])

const wait = (ms: number): Promise<void> => new Promise(r => setTimeout(r, ms))

function setMask(el: HTMLElement, img: string, size = `${4 * CELL}px ${4 * CELL}px`, pos = '0 0', repeat = 'repeat'): void {
  el.style.maskImage = img
  el.style.webkitMaskImage = img
  el.style.maskSize = size
  el.style.webkitMaskSize = size
  el.style.maskPosition = pos
  el.style.webkitMaskPosition = pos
  el.style.maskRepeat = repeat
}
function clearMask(el: HTMLElement): void {
  for (const p of ['maskImage', 'webkitMaskImage', 'maskSize', 'webkitMaskSize', 'maskPosition', 'webkitMaskPosition', 'maskRepeat'] as const)
    (el.style as unknown as Record<string, string>)[p] = ''
}

/** A · the whole text is reprinted dot by dot: an ordered-dither crossfade, 12 fps */
async function trame(from: HTMLElement, to: HTMLElement): Promise<void> {
  for (let l = 0; l <= 16; l += 2) {
    setMask(to, tiles[l][0])
    setMask(from, tiles[l][1])
    await wait(1000 / 14)
  }
}

/** B · the press passes: a band of boiling trame sweeps down the screen, new text behind it */
async function passe(from: HTMLElement, to: HTMLElement): Promise<void> {
  const W = Math.ceil(innerWidth / CELL)
  const H = Math.ceil(innerHeight / CELL)
  const band = Math.round(H * 0.28)
  const cNew = document.createElement('canvas')
  const cOld = document.createElement('canvas')
  cNew.width = cOld.width = W
  cNew.height = cOld.height = H
  const gNew = cNew.getContext('2d')!
  const gOld = cOld.getContext('2d')!
  const frames = 12
  for (let f = 0; f <= frames; f++) {
    const line = -band + (H + 2 * band) * (f / frames)
    const dNew = gNew.createImageData(W, H)
    const dOld = gOld.createImageData(W, H)
    for (let y = 0; y < H; y++) {
      const v = Math.min(1, Math.max(0, (line - y) / band)) // 1 above the band: new text
      for (let x = 0; x < W; x++) {
        const t = (BAYER4[(y % 4) * 4 + (x % 4)] + 0.5) / 16 + (Math.random() - 0.5) * 0.12 // the boil
        const on = t < v
        const i = (y * W + x) * 4 + 3
        dNew.data[i] = on ? 255 : 0
        dOld.data[i] = on ? 0 : 255
      }
    }
    gNew.putImageData(dNew, 0, 0)
    gOld.putImageData(dOld, 0, 0)
    for (const [el, c] of [[to, cNew], [from, cOld]] as const) {
      const top = -el.getBoundingClientRect().top
      setMask(el, `url(${c.toDataURL()})`, `${W * CELL}px ${H * CELL}px`, `0 ${top}px`, 'no-repeat')
      el.style.imageRendering = 'pixelated'
    }
    await wait(1000 / 14)
  }
}

/** C · riso misregistration: the plates drift apart and lift off, the new ones land in register */
async function repere(from: HTMLElement, to: HTMLElement): Promise<void> {
  from.dataset.plates = 'out'
  to.dataset.plates = 'pre'
  await wait(280)
  from.style.visibility = 'hidden'
  to.dataset.plates = 'in'
  await wait(320)
}

const variants = { trame, passe, repere } as Record<string, (a: HTMLElement, b: HTMLElement) => Promise<void>>

/** the block at the top of the screen, as « nth h2 + share of its section », to land the reader at the same place */
function anchorOf(ver: HTMLElement): { h: number, frac: number, dy: number } {
  const blocks = [...ver.querySelectorAll<HTMLElement>('.prose > *')]
  const first = blocks.find(b => b.getBoundingClientRect().bottom > 80)
  if (!first)
    return { h: -1, frac: 0, dy: 0 }
  const i = blocks.indexOf(first)
  const heads = blocks.map((b, k) => (b.tagName === 'H2' ? k : -1)).filter(k => k >= 0)
  const h = heads.filter(k => k <= i).length - 1
  const start = h >= 0 ? heads[h] : 0
  const end = heads[h + 1] ?? blocks.length
  return { h, frac: (i - start) / Math.max(1, end - start), dy: first.getBoundingClientRect().top }
}
function blockAt(ver: HTMLElement, a: { h: number, frac: number }): HTMLElement | undefined {
  const blocks = [...ver.querySelectorAll<HTMLElement>('.prose > *')]
  const heads = blocks.map((b, k) => (b.tagName === 'H2' ? k : -1)).filter(k => k >= 0)
  const start = a.h >= 0 ? heads[a.h] ?? 0 : 0
  const end = heads[a.h + 1] ?? blocks.length
  return blocks[start + Math.round(a.frac * (end - start))]
}

let busy = false
async function swap(lang: string): Promise<void> {
  const stage = document.querySelector<HTMLElement>('.lang-stage')!
  const from = stage.querySelector<HTMLElement>('.ver:not([hidden])')!
  const to = stage.querySelector<HTMLElement>(`.ver[data-lang="${lang}"]`)!
  if (busy || from === to)
    return
  busy = true
  document.querySelectorAll('.lang-switch [data-lang]').forEach(b => b.setAttribute('aria-current', String((b as HTMLElement).dataset.lang === lang)))

  const atTop = scrollY < 40
  const a = anchorOf(from)
  const oldAnchor = blockAt(from, a)
  to.hidden = false
  const newAnchor = blockAt(to, a)
  // keep the reader on the same passage: the new text's anchor lands where the old one was
  if (!atTop && oldAnchor && newAnchor) {
    from.style.top = `${newAnchor.offsetTop - oldAnchor.offsetTop}px`
    scrollTo({ top: scrollY + newAnchor.getBoundingClientRect().top - a.dy, behavior: 'instant' })
  }
  from.classList.add('is-leaving')

  if (!reduced())
    await variants[variant](from, to)

  from.hidden = true
  from.classList.remove('is-leaving')
  from.style.top = ''
  from.style.visibility = ''
  delete from.dataset.plates
  delete to.dataset.plates
  clearMask(from)
  clearMask(to)
  document.documentElement.dataset.postLang = lang
  busy = false
}

document.querySelectorAll<HTMLAnchorElement>('.lang-switch a[data-lang]').forEach((link) => {
  link.addEventListener('click', (e) => {
    e.preventDefault() // the real thing: a plain link to the other version, enhanced by this swap
    swap(link.dataset.lang!)
  })
})
</script>

<style>
  .proto-panel {
    position: fixed;
    right: 12px;
    bottom: 12px;
    z-index: 60;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-s);
    background: var(--paper);
    border: 1px solid var(--ink);
    font-family: var(--mono);
    font-size: var(--fs-tag);
    letter-spacing: var(--tr-data);
    text-transform: uppercase;
  }
  .pp-k { color: var(--ink-3); }
  .proto-panel button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    padding: 6px 10px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  .proto-panel button[aria-pressed='true'] { border-color: var(--ink); color: var(--ink); background: var(--paper-2); }
  .pp-rm { color: var(--ink-3); display: flex; gap: 4px; align-items: center; }

  /* both versions share one grid cell while they swap */
  :global(.lang-stage) { display: grid; }
  :global(.lang-stage > .ver) { grid-area: 1 / 1; position: relative; }
  :global(.lang-stage > .ver.is-leaving) { pointer-events: none; }

  /* C · repérage: two plates, ink + page ink, out of register then back */
  :global(.ver[data-plates]) { transition: color 0.3s steps(5), text-shadow 0.3s steps(5), opacity 0.3s steps(5); }
  :global(.ver[data-plates='out']) {
    color: transparent;
    text-shadow: -5px 1px 0 var(--accent), 5px -1px 0 rgb(24 23 15 / 0.55);
    opacity: 0;
  }
  :global(.ver[data-plates='pre']) {
    transition: none;
    color: transparent;
    text-shadow: 6px -1px 0 var(--accent), -6px 1px 0 rgb(24 23 15 / 0.55);
    opacity: 0;
  }
  :global(.ver[data-plates='out'] *),
  :global(.ver[data-plates='pre'] *) { color: transparent !important; }
  :global(.ver[data-plates='out'] img),
  :global(.ver[data-plates='pre'] img) { opacity: 0; }
  :global(.ver[data-plates='in']) {
    opacity: 1;
    text-shadow: 0 0 0 var(--accent), 0 0 0 rgb(24 23 15 / 0.55);
  }
</style>
