---
/**
 * SpotTweaks — le panneau de réglages du hero pop color (touche T).
 *
 * Outil de DESIGNER, réservé aux pages `/ds/*` : jamais sur une page publique. Porté de
 * l'atelier OD (`design/od/research/Article - PopColor.html`) le 2026-08-05 pour vivre
 * ici, typé — l'atelier reçoit les mises à jour par l'export, pas l'inverse.
 *
 * Il pilote le PREMIER `.post-hero` de la page via le handle que `HeroPopColor` expose
 * sur son élément (`hero.spotHero`, événement `spot-hero:ready`). La sortie « Recipe »
 * est dans la syntaxe des props du composant : elle se colle telle quelle dans un
 * frontmatter ou une page.
 *
 * Trois options opt-in du moteur y sont pilotables : le mode teinte (sélection par angle),
 * le fond des cellules éteintes (papier / photo / transparent) et l'éditeur de ZONES :
 * on dessine des polygones sur le hero (`in` = la sélection s'y restreint, `out` = elle
 * s'en retire), ils sortent dans la Recipe en coordonnées normalisées sur l'image.
 * Repris de l'outil de trame du carrousel (artefact vault 2026-11-12, `tweaks.html`).
 *
 * L'état persiste dans localStorage — mais les DÉFAUTS sont la recipe montée par la
 * page : un chargement frais montre toujours ce que le fichier décrit.
 */
---

<aside class="tw-panel tw-hidden" id="tw-panel" aria-label="Tweak panel">
  <header class="tw-head">
    <span class="ttl">Tweaks</span>
    <button class="tw-x" id="tw-close" type="button" aria-label="Hide panel" title="Hide (T)">×</button>
  </header>
  <div class="tw-body">
    <div id="tw-knobs"></div>
    <div class="tw-status" id="tw-imgstatus" role="status"></div>
  </div>

  <details class="tw-out">
    <summary>Recipe</summary>
    <textarea id="tw-recipe" readonly spellcheck="false" aria-label="Recipe for HeroPopColor"></textarea>
  </details>

  <footer class="tw-foot">
    <span><kbd>T</kbd><kbd>R</kbd></span>
    <button id="tw-reset" type="button">Reset</button>
    <button id="tw-copy" class="tw-copy" type="button">Copy recipe</button>
  </footer>
</aside>

<svg class="tw-ov" id="tw-ov" aria-hidden="true"></svg>

<button class="tw-restore tw-show" id="tw-restore" type="button" aria-label="Show tweaks panel" title="Tweaks (T)">T</button>

<script>
  import type { SpotGround, SpotHeroHandle, SpotHeroOptions, SpotMask } from '../../lib/spot-hero'
  import { Topo } from '../../scripts/texture'

  type Rgb = [number, number, number]
  type Duo = [string, string]

  interface TweakState {
    mode: 'pop' | 'invert'
    keep: 'dither' | 'sharp'
    keepColor: string
    threshold: number
    softness: number
    pop: number
    hueMode: boolean
    hueTol: number
    hueSoft: number
    satMin: number
    satSoft: number
    ground: Duo
    groundKind: SpotGround
    groundMix: number
    groundSat: number
    groundLift: number
    /** zones par photo, clé = nom du fichier : elles n'ont de sens que sur leur image */
    masks: Record<string, SpotMask[]>
    cell: number
    contrast: number
    brightness: number
    shimmer: number
    coverH: number
    focalX: number
    focalY: number
    title: string
    titleX: number
    titleY: number
    titleInk: 'light' | 'dark'
  }

  type Knob
    = | { sec: string }
      | { k: keyof TweakState, type: 'range', label: string, min: number, max: number, step: number, unit?: string, when?: Show }
      | { k: keyof TweakState, type: 'text', label: string, when?: Show }
      | { k: keyof TweakState, type: 'swatch', label: string, options: string[], when?: Show }
      | { k: keyof TweakState, type: 'duo', label: string, options: Duo[], when?: Show }
      | { k: keyof TweakState, type: 'seg', label: string, options: [string, string][], when?: Show }
      | { k: keyof TweakState, type: 'toggle', label: string, when?: Show }
      | { k: 'image', type: 'image', label: string }
      | { type: 'zones', label: string }

  /** un réglage qui ne s'applique que dans certains états se replie quand il ne sert pas */
  type Show = (s: TweakState) => boolean

  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches
  /* clé VERSIONNÉE : un état persisté par une version antérieure du panneau ne doit
     jamais s'appliquer — c'est lui qui faisait paraître le mode invert « à l'envers » */
  const STORAGE_KEY = 'tweaks-ds-hero-pop-color.v3'

  type DrawMode = 'off' | 'in' | 'out'

  const HUES = ['#c8321e', '#d2691e', '#d9a521', '#3f8f3a', '#1f8a7a', '#2f6fd0', '#7a5ae0', '#c0398f']
  const GROUNDS: Duo[] = [
    ['#14160f', '#4a4e3e'], /* olive   */
    ['#0a120b', '#36482c'], /* forêt   */
    ['#121212', '#454545'], /* charbon */
    ['#1c160c', '#5a4a30'], /* sépia   */
    ['#0f1722', '#3a4a5e'], /* ardoise */
  ]

  /* Les sources EN COULEUR du repo. Jamais les PNG déjà dithérés : la sélection se fait
     par teinte — une source monochrome ne fait rien popper. */
  const PRESETS = [
    { label: 'bridge red', src: '/photos/source/bridge-red-web.jpg' },
    { label: 'castle blue', src: '/photos/source/castle-blue-web.jpg' },
    { label: 'zones demo', src: '/photos/source/trame-zones-web.jpg' },
  ]

  const hero = document.querySelector<HTMLElement & { spotHero?: SpotHeroHandle }>('.post-hero')
  const heroImg = hero?.querySelector<HTMLImageElement>('img.dsrc') ?? null
  const fade = hero?.nextElementSibling instanceof HTMLElement && hero.nextElementSibling.classList.contains('hero-fade')
    ? hero.nextElementSibling
    : null

  function hexToRgb(h: string): Rgb {
    const s = h.replace('#', '')
    return [Number.parseInt(s.slice(0, 2), 16), Number.parseInt(s.slice(2, 4), 16), Number.parseInt(s.slice(4, 6), 16)]
  }

  /* Les défauts SONT la recipe montée par la page : lue sur data-recipe, pas dupliquée. */
  const initialName = heroImg?.src.split('/').pop() ?? ''

  function defaultsFromMount(): TweakState {
    const r: Partial<SpotHeroOptions> & { ink?: Rgb, paper?: Rgb } = JSON.parse(hero?.dataset.recipe ?? '{}')
    const toHex = (c: Rgb) => `#${c.map(v => v.toString(16).padStart(2, '0')).join('')}`
    return {
      mode: r.invert ? 'invert' : 'pop',
      keep: r.keepSharp ? 'sharp' : 'dither',
      keepColor: typeof r.keepColor === 'string' ? r.keepColor : '#c8321e',
      threshold: r.hueLo ?? 34,
      softness: r.hueSpan ?? 62,
      pop: r.satBoost ?? 0.35,
      hueMode: r.hueMode ?? false,
      hueTol: r.hueTol ?? 20,
      hueSoft: r.hueSoft ?? 12,
      satMin: r.satMin ?? 40,
      satSoft: r.satSoft ?? 20,
      groundKind: r.ground ?? 'flat',
      groundMix: r.groundMix ?? 0,
      groundSat: r.groundSat ?? 1,
      groundLift: r.groundLift ?? 0,
      masks: r.masks?.length ? { [initialName]: r.masks } : {},
      ground: [toHex(r.ink ?? [20, 22, 15]), toHex(r.paper ?? [74, 78, 62])],
      cell: r.cell ?? 3,
      contrast: r.contrast ?? 1.3,
      brightness: r.brightness ?? -0.02,
      shimmer: REDUCED ? 0 : (r.boil ?? 0.05),
      coverH: 100,
      focalX: Math.round((r.focalX ?? 0.5) * 100),
      focalY: Math.round((r.focalY ?? 0.5) * 100),
      title: hero?.querySelector('.ph-word')?.textContent?.trim() ?? 'Title',
      titleX: 4,
      titleY: 11,
      titleInk: hero?.dataset.titleInk === 'dark' ? 'dark' : 'light',
    }
  }

  const DEFAULTS = defaultsFromMount()

  const KNOBS: Knob[] = [
    { sec: 'Source' },
    { k: 'image', type: 'image', label: 'Photo' },

    { sec: 'Selective colour' },
    { k: 'mode', type: 'seg', label: 'Mode', options: [['pop', 'Pop'], ['invert', 'Invert']] },
    { k: 'keep', type: 'seg', label: 'Kept zone', options: [['dither', 'Dithered'], ['sharp', 'Sharp']] },
    { k: 'keepColor', type: 'swatch', label: 'Keep colour', options: HUES },
    { k: 'hueMode', type: 'toggle', label: 'Hue mode (angle)' },
    { k: 'threshold', type: 'range', label: 'Threshold', min: -40, max: 130, step: 1, when: s => !s.hueMode },
    { k: 'softness', type: 'range', label: 'Edge softness', min: 10, max: 160, step: 1, when: s => !s.hueMode },
    { k: 'hueTol', type: 'range', label: 'Hue tolerance', min: 0, max: 90, step: 1, unit: '°', when: s => s.hueMode },
    { k: 'hueSoft', type: 'range', label: 'Hue soft edge', min: 0, max: 60, step: 1, unit: '°', when: s => s.hueMode },
    { k: 'satMin', type: 'range', label: 'Min saturation', min: 0, max: 200, step: 1, when: s => s.hueMode },
    { k: 'satSoft', type: 'range', label: 'Saturation soft edge', min: 0, max: 100, step: 1, when: s => s.hueMode },
    { k: 'pop', type: 'range', label: 'Colour pop', min: 0, max: 1, step: 0.05 },

    { sec: 'Zones' },
    { type: 'zones', label: 'Draw on the cover' },

    { sec: 'Dithered ground' },
    { k: 'ground', type: 'duo', label: 'Tone', options: GROUNDS },
    { k: 'groundKind', type: 'seg', label: 'Off-cell ground', options: [['flat', 'Paper'], ['photo', 'Photo'], ['transparent', 'Clear']] },
    { k: 'groundMix', type: 'range', label: 'Mix toward paper', min: 0, max: 1, step: 0.05, when: s => s.groundKind === 'photo' },
    { k: 'groundSat', type: 'range', label: 'Photo saturation', min: 0, max: 1.5, step: 0.05, when: s => s.groundKind === 'photo' },
    { k: 'groundLift', type: 'range', label: 'Photo lift', min: -0.3, max: 0.6, step: 0.01, when: s => s.groundKind === 'photo' },
    { k: 'cell', type: 'range', label: 'Dot size', min: 2, max: 6, step: 1, unit: 'px' },
    { k: 'contrast', type: 'range', label: 'Contrast', min: 0.8, max: 1.8, step: 0.02 },
    { k: 'brightness', type: 'range', label: 'Brightness', min: -0.25, max: 0.25, step: 0.01 },
    { k: 'shimmer', type: 'range', label: 'Shimmer', min: 0, max: 0.18, step: 0.01 },

    { sec: 'Cover & type' },
    { k: 'coverH', type: 'range', label: 'Cover height', min: 60, max: 100, step: 1, unit: 'vh' },
    { k: 'focalX', type: 'range', label: 'Focal X', min: 0, max: 100, step: 1, unit: '%' },
    { k: 'focalY', type: 'range', label: 'Focal Y', min: 0, max: 100, step: 1, unit: '%' },
    { k: 'title', type: 'text', label: 'Title' },
    { k: 'titleX', type: 'range', label: 'Title X', min: 0, max: 70, step: 1, unit: '%' },
    { k: 'titleY', type: 'range', label: 'Title Y', min: 2, max: 62, step: 1, unit: '%' },
    { k: 'titleInk', type: 'seg', label: 'Title ink', options: [['light', 'Light'], ['dark', 'Dark']] },
  ]

  /* l'image chargée n'entre PAS dans l'état persisté : une data-URI de plusieurs Mo
     dépasserait le quota de localStorage */
  let loadedName = heroImg?.src.split('/').pop() ?? ''
  let loadedPreset: string | null = null

  function load(): TweakState {
    try {
      const raw = localStorage.getItem(STORAGE_KEY)
      if (!raw)
        return { ...DEFAULTS }
      const s: TweakState = { ...DEFAULTS, ...JSON.parse(raw) }
      if (REDUCED)
        s.shimmer = 0
      return s
    }
    catch {
      return { ...DEFAULTS }
    }
  }
  function save(s: TweakState) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(s))
    }
    catch {}
  }

  function drawHeroTopo(ink: Rgb) {
    const topo = hero?.querySelector<HTMLCanvasElement>('canvas.topo-on')
    if (!topo)
      return
    Topo.draw(topo, {
      color: `rgba(${Math.min(255, ink[0] + 96)}, ${Math.min(255, ink[1] + 110)}, ${Math.min(255, ink[2] + 80)}, 0.22)`,
      levels: 16,
      cell: 18,
      scale: 0.003,
      seed: 9,
      emphasizeEvery: 4,
    })
  }

  /* le masque se rasterise à chaque envoi : on ne l'envoie que quand il a changé
     (édition de zone, changement de photo) */
  let masksDirty = true
  let draft: [number, number][] = []

  function currentMasks(s: TweakState): SpotMask[] {
    return s.masks[loadedName] ?? []
  }

  function apply(s: TweakState) {
    if (!hero)
      return
    const ink = hexToRgb(s.ground[0])
    const paper = hexToRgb(s.ground[1])

    hero.spotHero?.update({
      cell: s.cell,
      ink,
      paper,
      contrast: s.contrast,
      brightness: s.brightness,
      boil: s.shimmer,
      keepColor: s.keepColor,
      hueLo: s.threshold,
      hueSpan: s.softness,
      satBoost: s.pop,
      invert: s.mode === 'invert',
      keepSharp: s.keep === 'sharp',
      hueMode: s.hueMode,
      hueTol: s.hueTol,
      hueSoft: s.hueSoft,
      satMin: s.satMin,
      satSoft: s.satSoft,
      ground: s.groundKind,
      groundMix: s.groundMix,
      groundSat: s.groundSat,
      groundLift: s.groundLift,
      ...(masksDirty ? { masks: currentMasks(s) } : {}),
      focalX: s.focalX / 100,
      focalY: s.focalY / 100,
    })
    masksDirty = false
    drawHeroTopo(ink)

    /* les variables du composant sont posées en inline par define:vars — on les
       réécrit au même endroit, sur le hero ET sur son hero-fade */
    const h = `${s.coverH}vh`
    const heightChanged = hero.style.getPropertyValue('--phHeight') !== h
    for (const el of [hero, fade].filter((e): e is HTMLElement => e !== null)) {
      el.style.setProperty('--phHeight', h)
      el.style.setProperty('--phGround', ink.join(', '))
      el.style.setProperty('--phTitleX', `${s.titleX}%`)
      el.style.setProperty('--phTitleYBase', `${s.titleY}%`)
    }
    /* la hauteur change clientHeight sans émettre de resize ; le moteur écoute resize */
    if (heightChanged)
      dispatchEvent(new Event('resize'))

    hero.dataset.titleInk = s.titleInk
    const word = hero.querySelector<HTMLElement>('.ph-word')
    if (word)
      word.textContent = s.title

    paint(s)
    writeRecipe(s)
    drawOverlay()
  }

  /* ---- la sortie : la recipe aux noms des props du composant ---- */
  function num(v: number): string {
    return Number.isInteger(v) ? String(v) : String(Number.parseFloat(v.toFixed(3)))
  }

  function recipeSnippet(s: TweakState): string {
    const ink = hexToRgb(s.ground[0])
    const paper = hexToRgb(s.ground[1])
    return [
      'spot={{',
      `  keepColor: '${s.keepColor}',`,
      `  ink: [${ink.join(', ')}],`,
      `  paper: [${paper.join(', ')}],`,
      `  cell: ${num(s.cell)},`,
      `  contrast: ${num(s.contrast)},`,
      `  brightness: ${num(s.brightness)},`,
      `  boil: ${num(s.shimmer)},`,
      ...(s.hueMode
        ? [
            '  hueMode: true,',
            `  hueTol: ${num(s.hueTol)},`,
            `  hueSoft: ${num(s.hueSoft)},`,
            `  satMin: ${num(s.satMin)},`,
            `  satSoft: ${num(s.satSoft)},`,
          ]
        : [`  hueLo: ${num(s.threshold)},`, `  hueSpan: ${num(s.softness)},`]),
      `  satBoost: ${num(s.pop)},`,
      ...(s.mode === 'invert' ? ['  invert: true,'] : []),
      ...(s.keep === 'sharp' ? ['  keepSharp: true,'] : []),
      ...(s.groundKind !== 'flat' ? [`  ground: '${s.groundKind}',`] : []),
      ...(s.groundKind === 'photo'
        ? [`  groundMix: ${num(s.groundMix)},`, `  groundSat: ${num(s.groundSat)},`, `  groundLift: ${num(s.groundLift)},`]
        : []),
      ...(currentMasks(s).length
        ? [
            '  masks: [',
            ...currentMasks(s).map(m =>
              `    { mode: '${m.mode}', pts: [${m.pts.map(p => `[${num(p[0])}, ${num(p[1])}]`).join(', ')}] },`),
            '  ],',
          ]
        : []),
      '}}',
      `title="${s.title}"`,
      ...(s.titleX !== 4 ? [`titleX="${s.titleX}%"`] : []),
      `titleY="${s.titleY}%"`,
      `titleInk="${s.titleInk}"`,
      `height="${s.coverH}vh"`,
      `focal={{ x: ${num(s.focalX / 100)}, y: ${num(s.focalY / 100)} }}`,
      '',
      '// titleYMobile : override ≤700px à vérifier sur le vrai breakpoint,',
      '// contraste du titre ≥3:1 MESURÉ (PIPELINE §4.6b).',
    ].join('\n')
  }

  function writeRecipe(s: TweakState) {
    const out = document.querySelector<HTMLTextAreaElement>('#tw-recipe')
    if (out)
      out.value = recipeSnippet(s)
  }

  /* ---- rendu du panneau depuis KNOBS ---- */
  function fmt(knob: Extract<Knob, { type: 'range' }>, v: number): string {
    const n = Number.isInteger(v) ? String(v) : v.toFixed(2)
    return n + (knob.unit ?? '')
  }

  function paint(s: TweakState) {
    for (const knob of KNOBS) {
      if (!('k' in knob) || knob.type === 'image')
        continue
      const host = document.getElementById(`k-${knob.k}`)
      if (!host)
        continue
      const rowEl = document.getElementById(`row-${knob.k}`)
      if (rowEl)
        rowEl.hidden = knob.when ? !knob.when(s) : false
      const v = s[knob.k]
      if (knob.type === 'range') {
        (host as HTMLInputElement).value = String(v)
        const val = document.getElementById(`v-${knob.k}`)
        if (val)
          val.textContent = fmt(knob, v as number)
      }
      else if (knob.type === 'text') {
        const input = host as HTMLInputElement
        if (input.value !== v)
          input.value = String(v)
      }
      else if (knob.type === 'swatch' || knob.type === 'duo') {
        const key = String(v)
        host.querySelectorAll('button').forEach(b =>
          b.setAttribute('aria-pressed', b.dataset.val === key ? 'true' : 'false'))
      }
      else if (knob.type === 'seg') {
        host.querySelectorAll('button').forEach(b =>
          b.setAttribute('aria-pressed', b.dataset.val === v ? 'true' : 'false'))
      }
      else if (knob.type === 'toggle') {
        (host as HTMLInputElement).checked = Boolean(v)
      }
    }
    paintZones(s)
  }

  const state = load()

  function commit<K extends keyof TweakState>(key: K, value: TweakState[K]) {
    state[key] = value
    save(state)
    apply(state)
  }

  /* ---- sonde de lisibilité : le moteur avale son échec (canvas contaminé) ---- */
  function pixelsReadable(img: HTMLImageElement): boolean {
    try {
      const c = document.createElement('canvas')
      c.width = 1
      c.height = 1
      const x = c.getContext('2d')!
      x.drawImage(img, 0, 0, 1, 1)
      x.getImageData(0, 0, 1, 1)
      return true
    }
    catch {
      return false
    }
  }

  function status() {
    const el = document.getElementById('tw-imgstatus')
    if (!el || !heroImg)
      return
    const w = heroImg.naturalWidth
    const h = heroImg.naturalHeight
    if (!w) {
      el.dataset.ok = 'yes'
      el.innerHTML = 'Chargement…'
      return
    }
    const ok = pixelsReadable(heroImg)
    el.dataset.ok = ok ? 'yes' : 'no'
    const dc = hero?.querySelector<HTMLCanvasElement>('canvas.dither-canvas')
    if (dc)
      dc.style.visibility = ok ? '' : 'hidden'
    el.innerHTML = ok
      ? `<b>${loadedName}</b> · ${w}×${h} · pixels lisibles`
      : `<b>Pixels illisibles</b> — ${loadedName} : canvas contaminé, le moteur ne peint pas. `
        + `Charge l'image par le sélecteur de fichier (data-URI), jamais contaminé.`
  }
  heroImg?.addEventListener('load', status)

  /* ---- chargeur d'image : un fichier local lu en data-URI ne contamine jamais ---- */
  function setImage(src: string, name: string) {
    if (!heroImg)
      return
    heroImg.src = src
    heroImg.alt = `Source photograph: ${name}`
    masksDirty = true
    draft = []
    paintPresets()
    status()
  }

  function loadFile(file: File | null | undefined) {
    if (!file || !file.type.startsWith('image/'))
      return
    const fr = new FileReader()
    fr.onload = () => {
      loadedPreset = null
      loadedName = file.name
      setImage(String(fr.result), file.name)
    }
    fr.readAsDataURL(file)
  }

  function loadPreset(p: { label: string, src: string }) {
    loadedPreset = p.src
    loadedName = p.src.split('/').pop() ?? p.src
    setImage(p.src, loadedName)
  }

  function paintPresets() {
    const host = document.getElementById('k-image-presets')
    host?.querySelectorAll('button').forEach(b =>
      b.setAttribute('aria-pressed', b.dataset.src === loadedPreset ? 'true' : 'false'))
  }

  /* déposer n'importe où sur la page, pas seulement sur le petit bouton */
  addEventListener('dragover', (e) => {
    e.preventDefault()
    document.querySelector<HTMLElement>('.tw-file')?.setAttribute('data-drag', 'on')
  })
  addEventListener('dragleave', () => {
    document.querySelector<HTMLElement>('.tw-file')?.removeAttribute('data-drag')
  })
  addEventListener('drop', (e) => {
    e.preventDefault()
    document.querySelector<HTMLElement>('.tw-file')?.removeAttribute('data-drag')
    loadFile(e.dataTransfer?.files?.[0])
  })

  function build() {
    const host = document.getElementById('tw-knobs')
    if (!host)
      return
    host.innerHTML = ''

    for (const knob of KNOBS) {
      if ('sec' in knob) {
        const h = document.createElement('div')
        h.className = 'tw-sec'
        h.textContent = knob.sec
        host.appendChild(h)
        continue
      }

      const row = document.createElement('div')
      row.className = 'tw-row'
      if ('k' in knob)
        row.id = `row-${knob.k}`

      const lbl = document.createElement('span')
      lbl.className = 'lbl'
      lbl.innerHTML = `<span>${knob.label}</span>`
      if (knob.type === 'range') {
        const val = document.createElement('span')
        val.className = 'val'
        val.id = `v-${knob.k}`
        lbl.appendChild(val)
      }
      row.appendChild(lbl)

      if (knob.type === 'range') {
        const r = document.createElement('input')
        r.type = 'range'
        r.className = 'tw-range'
        r.id = `k-${knob.k}`
        r.min = String(knob.min)
        r.max = String(knob.max)
        r.step = String(knob.step)
        r.setAttribute('aria-label', knob.label)
        r.addEventListener('input', () => commit(knob.k, Number.parseFloat(r.value) as never))
        row.appendChild(r)
      }
      else if (knob.type === 'text') {
        const t = document.createElement('input')
        t.type = 'text'
        t.className = 'tw-text'
        t.id = `k-${knob.k}`
        t.setAttribute('aria-label', knob.label)
        t.addEventListener('input', () => commit(knob.k, t.value as never))
        row.appendChild(t)
      }
      else if (knob.type === 'swatch') {
        const grid = document.createElement('div')
        grid.className = 'tw-swatches'
        grid.id = `k-${knob.k}`
        grid.setAttribute('role', 'radiogroup')
        grid.setAttribute('aria-label', knob.label)
        for (const hex of knob.options) {
          const b = document.createElement('button')
          b.type = 'button'
          b.className = 'tw-swatch'
          b.dataset.val = hex
          b.style.background = hex
          b.setAttribute('aria-label', hex)
          b.addEventListener('click', () => commit(knob.k, hex as never))
          grid.appendChild(b)
        }
        row.appendChild(grid)
      }
      else if (knob.type === 'duo') {
        const grid = document.createElement('div')
        grid.className = 'tw-swatches duo'
        grid.id = `k-${knob.k}`
        grid.setAttribute('role', 'radiogroup')
        grid.setAttribute('aria-label', knob.label)
        for (const pair of knob.options) {
          const b = document.createElement('button')
          b.type = 'button'
          b.className = 'tw-swatch'
          b.dataset.val = String(pair)
          b.style.background = `linear-gradient(105deg, ${pair[0]} 0 50%, ${pair[1]} 50% 100%)`
          b.setAttribute('aria-label', pair.join(' / '))
          b.addEventListener('click', () => commit(knob.k, pair as never))
          grid.appendChild(b)
        }
        row.appendChild(grid)
      }
      else if (knob.type === 'image') {
        const pick = document.createElement('label')
        pick.className = 'tw-file'
        pick.textContent = 'Choose file · or drop anywhere'
        const inp = document.createElement('input')
        inp.type = 'file'
        inp.accept = 'image/*'
        inp.addEventListener('change', () => loadFile(inp.files?.[0]))
        pick.appendChild(inp)
        row.appendChild(pick)

        const grid = document.createElement('div')
        grid.className = 'tw-presets'
        grid.id = 'k-image-presets'
        grid.setAttribute('role', 'radiogroup')
        grid.setAttribute('aria-label', 'Project sources')
        for (const p of PRESETS) {
          const b = document.createElement('button')
          b.type = 'button'
          b.dataset.src = p.src
          b.textContent = p.label
          b.title = p.src
          b.addEventListener('click', () => loadPreset(p))
          grid.appendChild(b)
        }
        row.appendChild(grid)
      }
      else if (knob.type === 'toggle') {
        const t = document.createElement('input')
        t.type = 'checkbox'
        t.className = 'tw-check'
        t.id = `k-${knob.k}`
        t.setAttribute('aria-label', knob.label)
        t.addEventListener('change', () => commit(knob.k, t.checked as never))
        row.appendChild(t)
      }
      else if (knob.type === 'zones') {
        const seg = document.createElement('div')
        seg.className = 'tw-seg'
        seg.id = 'k-zonemode'
        seg.setAttribute('role', 'radiogroup')
        seg.setAttribute('aria-label', knob.label)
        for (const [val, label] of [['off', 'Off'], ['in', 'Draw in'], ['out', 'Draw out']] as const) {
          const b = document.createElement('button')
          b.type = 'button'
          b.dataset.val = val
          b.textContent = label
          b.addEventListener('click', () => setDrawMode(val))
          seg.appendChild(b)
        }
        row.appendChild(seg)
        const hint = document.createElement('p')
        hint.className = 'tw-hint'
        hint.id = 'k-zonehint'
        hint.textContent = 'Click to add points · Enter or click the first point closes · Backspace undoes a point · Esc cancels'
        row.appendChild(hint)
        const list = document.createElement('div')
        list.className = 'tw-zones'
        list.id = 'k-zonelist'
        row.appendChild(list)
      }
      else if (knob.type === 'seg') {
        const seg = document.createElement('div')
        seg.className = 'tw-seg'
        seg.id = `k-${knob.k}`
        seg.setAttribute('role', 'radiogroup')
        seg.setAttribute('aria-label', knob.label)
        for (const [val, label] of knob.options) {
          const b = document.createElement('button')
          b.type = 'button'
          b.dataset.val = val
          b.textContent = label
          b.addEventListener('click', () => commit(knob.k, val as never))
          seg.appendChild(b)
        }
        row.appendChild(seg)
      }

      host.appendChild(row)
    }
  }

  /* ---- éditeur de zones ----
     Les polygones sont stockés en coordonnées normalisées sur l'IMAGE (comme le moteur les
     attend) ; l'overlay les projette en px du hero avec le même cover-fit que le moteur. */
  const SVGNS = 'http://www.w3.org/2000/svg'
  const overlay = document.getElementById('tw-ov') as unknown as SVGSVGElement | null
  let drawMode: DrawMode = 'off'
  let cursor: [number, number] | null = null

  if (overlay && hero)
    hero.appendChild(overlay)

  /* le même cover-fit que `build()` du moteur, en px du hero : sx/sy = taille d'une cellule */
  function coverFit() {
    if (!hero || !heroImg || !heroImg.naturalWidth)
      return null
    const cw = hero.clientWidth || 320
    const ch = hero.clientHeight || 240
    const lw = Math.max(1, Math.floor(cw / state.cell))
    const lh = Math.max(1, Math.floor(ch / state.cell))
    const ir = heroImg.naturalWidth / heroImg.naturalHeight
    const fx = state.focalX / 100
    const fy = state.focalY / 100
    let dw: number
    let dh: number
    let dx: number
    let dy: number
    if (ir > lw / lh) {
      dh = lh
      dw = lh * ir
      dx = (lw - dw) * fx
      dy = 0
    }
    else {
      dw = lw
      dh = lw / ir
      dx = 0
      dy = (lh - dh) * fy
    }
    return { cw, ch, sx: cw / lw, sy: ch / lh, dx, dy, dw, dh }
  }

  function toFrame(f: NonNullable<ReturnType<typeof coverFit>>, p: [number, number]): [number, number] {
    return [(f.dx + p[0] * f.dw) * f.sx, (f.dy + p[1] * f.dh) * f.sy]
  }

  function toImg(f: NonNullable<ReturnType<typeof coverFit>>, x: number, y: number): [number, number] {
    const nx = (x / f.sx - f.dx) / f.dw
    const ny = (y / f.sy - f.dy) / f.dh
    return [Math.min(1, Math.max(0, nx)), Math.min(1, Math.max(0, ny))]
  }

  function svgEl<K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string>) {
    const el = document.createElementNS(SVGNS, tag)
    for (const [k, v] of Object.entries(attrs))
      el.setAttribute(k, v)
    return el
  }

  function drawOverlay() {
    if (!overlay)
      return
    overlay.replaceChildren()
    overlay.dataset.draw = drawMode
    const f = coverFit()
    if (!f || drawMode === 'off')
      return
    overlay.setAttribute('viewBox', `0 0 ${f.cw} ${f.ch}`)
    for (const m of currentMasks(state)) {
      const pts = m.pts.map(p => toFrame(f, p).join(',')).join(' ')
      overlay.appendChild(svgEl('polygon', m.mode === 'in'
        ? { 'points': pts, 'fill': 'rgba(196, 106, 62, 0.28)', 'stroke': '#c46a3e', 'stroke-width': '2' }
        : { 'points': pts, 'fill': 'rgba(255, 255, 255, 0.18)', 'stroke': '#fff', 'stroke-width': '2', 'stroke-dasharray': '6 4' }))
    }
    if (draft.length) {
      const pts = [...draft, ...(cursor ? [cursor] : [])].map(p => toFrame(f, p).join(','))
      overlay.appendChild(svgEl('polyline', { 'points': pts.join(' '), 'fill': 'none', 'stroke': '#fff', 'stroke-width': '2' }))
      draft.forEach((p, i) => {
        const [x, y] = toFrame(f, p)
        overlay.appendChild(svgEl('circle', { 'cx': String(x), 'cy': String(y), 'r': i === 0 ? '6' : '3.5', 'fill': i === 0 ? '#c46a3e' : '#fff', 'stroke': '#000', 'stroke-width': '1' }))
      })
    }
  }

  function paintZones(s: TweakState) {
    document.getElementById('k-zonemode')?.querySelectorAll('button').forEach(b =>
      b.setAttribute('aria-pressed', b.dataset.val === drawMode ? 'true' : 'false'))
    const list = document.getElementById('k-zonelist')
    if (!list)
      return
    list.replaceChildren()
    const ms = currentMasks(s)
    ms.forEach((m, i) => {
      const item = document.createElement('div')
      item.className = 'tw-zone'
      const name = document.createElement('span')
      name.textContent = `${m.mode === 'in' ? 'In' : 'Out'} · ${m.pts.length} pts`
      const del = document.createElement('button')
      del.type = 'button'
      del.textContent = '×'
      del.setAttribute('aria-label', `Delete zone ${i + 1}`)
      del.addEventListener('click', () => editMasks(ms.filter((_, j) => j !== i)))
      item.append(name, del)
      list.appendChild(item)
    })
  }

  function editMasks(next: SpotMask[]) {
    if (next.length)
      state.masks[loadedName] = next
    else
      delete state.masks[loadedName]
    masksDirty = true
    save(state)
    apply(state)
  }

  function setDrawMode(m: DrawMode) {
    drawMode = m
    draft = []
    cursor = null
    if (overlay)
      overlay.style.pointerEvents = m === 'off' ? 'none' : 'auto'
    drawOverlay()
    paintZones(state)
  }

  function closeDraft() {
    if (draft.length >= 3 && drawMode !== 'off') {
      const mode = drawMode
      const pts = draft
      draft = []
      cursor = null
      editMasks([...currentMasks(state), { mode, pts }])
      return
    }
    drawOverlay()
  }

  overlay?.addEventListener('pointerdown', (e) => {
    const f = coverFit()
    if (!f || drawMode === 'off')
      return
    e.preventDefault()
    const r = overlay.getBoundingClientRect()
    const x = (e.clientX - r.left) * (f.cw / r.width)
    const y = (e.clientY - r.top) * (f.ch / r.height)
    if (draft.length >= 3) {
      const [fx, fy] = toFrame(f, draft[0])
      if (Math.hypot(fx - x, fy - y) < 12) {
        closeDraft()
        return
      }
    }
    draft.push(toImg(f, x, y))
    drawOverlay()
  })

  overlay?.addEventListener('pointermove', (e) => {
    const f = coverFit()
    if (!f || !draft.length)
      return
    const r = overlay.getBoundingClientRect()
    cursor = toImg(f, (e.clientX - r.left) * (f.cw / r.width), (e.clientY - r.top) * (f.ch / r.height))
    drawOverlay()
  })

  addEventListener('keydown', (e) => {
    if (drawMode === 'off' || (e.target as HTMLElement).matches('input, textarea, select, button, [contenteditable]'))
      return
    if (e.key === 'Enter') {
      e.preventDefault()
      closeDraft()
    }
    else if (e.key === 'Backspace') {
      e.preventDefault()
      draft.pop()
      drawOverlay()
    }
    else if (e.key === 'Escape') {
      if (draft.length) {
        draft = []
        cursor = null
      }
      else {
        setDrawMode('off')
        return
      }
      drawOverlay()
    }
  })

  addEventListener('resize', drawOverlay)
  heroImg?.addEventListener('load', drawOverlay)

  /* ---- ouverture : replié par défaut (la preview d'abord), la pastille T le rappelle ---- */
  const panel = document.getElementById('tw-panel')!
  const restore = document.getElementById('tw-restore')!

  function setPanelVisible(v: boolean) {
    panel.classList.toggle('tw-hidden', !v)
    restore.classList.toggle('tw-show', !v)
  }
  document.getElementById('tw-close')?.addEventListener('click', () => setPanelVisible(false))
  restore.addEventListener('click', () => setPanelVisible(true))

  function reset() {
    Object.assign(state, DEFAULTS, { masks: structuredClone(DEFAULTS.masks) })
    masksDirty = true
    setDrawMode('off')
    save(state)
    apply(state)
  }
  document.getElementById('tw-reset')?.addEventListener('click', reset)

  /* ---- copie de la recipe ---- */
  const copyBtn = document.getElementById('tw-copy')!
  const outBox = document.querySelector<HTMLTextAreaElement>('#tw-recipe')!

  function flash(label: string) {
    copyBtn.textContent = label
    copyBtn.dataset.done = 'on'
    setTimeout(() => {
      copyBtn.textContent = 'Copy recipe'
      delete copyBtn.dataset.done
    }, 1400)
  }

  copyBtn.addEventListener('click', async () => {
    const text = recipeSnippet(state)
    try {
      await navigator.clipboard.writeText(text)
      flash('Copied')
      return
    }
    catch { /* refusé — replis */ }
    const details = outBox.closest('details')
    if (details)
      details.open = true
    outBox.focus()
    outBox.select()
    flash('Select + ⌘C')
  })

  /* ---- raccourcis ---- */
  addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey)
      return
    const t = e.target as HTMLElement
    if (t.matches('input, textarea, select, [contenteditable]'))
      return
    if (e.key === 't' || e.key === 'T') {
      e.preventDefault()
      setPanelVisible(panel.classList.contains('tw-hidden'))
    }
    else if (e.key === 'r' || e.key === 'R') {
      e.preventDefault()
      reset()
    }
  })

  /* démarrage : attendre le handle si le hero n'est pas encore monté */
  function start() {
    build()
    apply(state)
    status()
  }
  if (hero?.spotHero)
    start()
  else
    hero?.addEventListener('spot-hero:ready', start, { once: true })
</script>

