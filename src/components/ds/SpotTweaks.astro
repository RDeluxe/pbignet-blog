---
/**
 * SpotTweaks — le panneau de réglages du hero pop color (touche T).
 *
 * Outil de DESIGNER, réservé aux pages `/ds/*` : jamais sur une page publique. Porté de
 * l'atelier OD (`design/od/research/Article - PopColor.html`) le 2026-08-05 pour vivre
 * ici, typé — l'atelier reçoit les mises à jour par l'export, pas l'inverse.
 *
 * Il pilote le PREMIER `.post-hero` de la page via le handle que `HeroPopColor` expose
 * sur son élément (`hero.spotHero`, événement `spot-hero:ready`). La sortie « Recipe »
 * est dans la syntaxe des props du composant : elle se colle telle quelle dans un
 * frontmatter ou une page.
 *
 * Trois options opt-in du moteur y sont pilotables : le mode teinte (sélection par angle),
 * le fond des cellules éteintes (papier / photo / transparent) et l'éditeur de ZONES :
 * on dessine des polygones sur le hero (`in` = la sélection s'y restreint, `out` = elle
 * s'en retire), ils sortent dans la Recipe en coordonnées normalisées sur l'image.
 * Repris de l'outil de trame du carrousel (artefact vault 2026-11-12, `tweaks.html`).
 *
 * Une zone peut aussi porter son propre traitement : `photo` (la photo nette, sans filtre)
 * ou `dither` (sa propre trame : encre, papier, contraste, luminosité, taille de point).
 * Le mode `None` coupe la couleur sélective partout (`pop: false`).
 *
 * L'état persiste dans localStorage — mais les DÉFAUTS sont la recipe montée par la
 * page : un chargement frais montre toujours ce que le fichier décrit. Les covers des
 * articles s'ajoutent aux sources : les choisir charge leur recipe, zones comprises.
 * Chaque modification s'écrit aussi dans un brouillon par photo : rechoisir la photo
 * reprend son brouillon plutôt que le fichier ; Reset le jette.
 */
import { getCollection } from 'astro:content'

/* une cover par photo : les traductions partagent la leur */
const covers = new Map<string, { label: string, src: string, recipe: Record<string, unknown> }>()
for (const post of await getCollection('writing')) {
  const c = post.data.cover
  if (c?.kind !== 'pop-color' || covers.has(c.src))
    continue
  covers.set(c.src, {
    label: post.id.replace(/^fr-/, '').split('-').slice(0, 3).join(' '),
    src: c.src,
    recipe: {
      ...c.spot,
      focalX: c.focal?.x,
      focalY: c.focal?.y,
      title: c.word ?? post.data.title,
      titleX: c.titleX,
      titleY: c.titleY,
      titleYMobile: c.titleYMobile,
      titleInk: c.titleInk,
      height: c.height,
    },
  })
}

/* Save (dev only): every post a recipe can be written into, with what the editor needs to
   pick the right one and to know whether a translation shares the cover */
const posts = import.meta.env.DEV
  ? (await getCollection('writing'))
      .map(post => ({
        slug: post.id,
        lang: post.data.lang,
        translation: post.data.translation,
        src: post.data.cover?.src,
        hasAlt: Boolean(post.data.cover?.alt),
      }))
      .sort((a, b) => a.slug.localeCompare(b.slug))
  : []
---

<aside class="tw-panel tw-hidden" id="tw-panel" aria-label="Tweak panel" data-covers={JSON.stringify([...covers.values()])}>
  <header class="tw-head">
    <span class="ttl">Tweaks</span>
    <button class="tw-x" id="tw-close" type="button" aria-label="Hide panel" title="Hide (T)">×</button>
  </header>
  <div class="tw-body">
    <div id="tw-knobs"></div>
    <div class="tw-status" id="tw-imgstatus" role="status"></div>
  </div>

  <details class="tw-out">
    <summary>Recipe</summary>
    <textarea id="tw-recipe" readonly spellcheck="false" aria-label="Recipe for HeroPopColor"></textarea>
  </details>

  {import.meta.env.DEV && (
    <section class="tw-save" id="tw-save" data-posts={JSON.stringify(posts)} aria-label="Save the recipe into a post">
      <label class="tw-save-row">
        <span>Article</span>
        <select id="tw-save-post"></select>
      </label>
      <label class="tw-save-row" id="tw-save-both-row" hidden>
        <input type="checkbox" id="tw-save-both" checked />
        <span id="tw-save-both-label">+ traduction</span>
      </label>
      <label class="tw-save-row" id="tw-save-alt-row" hidden>
        <span>Alt</span>
        <input type="text" id="tw-save-alt" placeholder="Ce que montre la photo" />
      </label>
      <div class="tw-save-row">
        <p class="tw-save-msg" id="tw-save-msg" role="status"></p>
        <button id="tw-save-btn" class="tw-copy" type="button">Enregistrer</button>
      </div>
    </section>
  )}

  <footer class="tw-foot">
    <span><kbd>T</kbd><kbd>R</kbd></span>
    <button id="tw-phone" type="button" aria-pressed="false" title="La cover à 390 px de large, comme sur un téléphone">Aperçu mobile</button>
    <button id="tw-reset" type="button">Reset</button>
    <button id="tw-copy" class="tw-copy" type="button">Copy recipe</button>
  </footer>
</aside>

<svg class="tw-ov" id="tw-ov" aria-hidden="true"></svg>

<!-- l'aperçu mobile : cette même page dans un cadre de 390 px, ses breakpoints réels -->
<div class="tw-phone" id="tw-phone-frame" hidden>
  <span class="tw-phone-cap">390 px</span>
  <iframe id="tw-phone-view" title="Aperçu mobile de la cover"></iframe>
</div>

<button class="tw-restore tw-show" id="tw-restore" type="button" aria-label="Show tweaks panel" title="Tweaks (T)">T</button>

<script>
  import type { SpotGround, SpotHeroHandle, SpotHeroOptions, SpotMask } from '../../lib/spot-hero'
  import { traceZone } from '../../lib/spot-hero'
  import { Topo } from '../../scripts/texture'

  type Rgb = [number, number, number]
  type Duo = [string, string]

  interface TweakState {
    /** `none` = aucune couleur ne poppe (`pop: false`) */
    mode: 'pop' | 'invert' | 'none'
    keep: 'dither' | 'sharp'
    keepColor: string
    threshold: number
    softness: number
    pop: number
    hueMode: boolean
    hueTol: number
    hueSoft: number
    satMin: number
    satSoft: number
    ground: Duo
    groundKind: SpotGround
    groundMix: number
    groundSat: number
    groundLift: number
    /** zones par photo, clé = nom du fichier : elles n'ont de sens que sur leur image */
    masks: Record<string, EdZone[]>
    cell: number
    contrast: number
    brightness: number
    shimmer: number
    coverH: number
    focalX: number
    focalY: number
    title: string
    titleX: number
    titleY: number
    /** placement du titre en étroit (≤700px) */
    titleYMobile: number
    titleInk: 'light' | 'dark'
  }

  type Knob
    = | { sec: string }
      | { k: keyof TweakState, type: 'range', label: string, min: number, max: number, step: number, unit?: string, when?: Show }
      | { k: keyof TweakState, type: 'text', label: string, when?: Show }
      | { k: keyof TweakState, type: 'swatch', label: string, options: string[], when?: Show }
      | { k: keyof TweakState, type: 'duo', label: string, options: Duo[], when?: Show }
      | { k: keyof TweakState, type: 'seg', label: string, options: [string, string][], when?: Show }
      | { k: keyof TweakState, type: 'toggle', label: string, when?: Show }
      | { k: 'image', type: 'image', label: string }
      | { type: 'zones', label: string }

  /** un réglage qui ne s'applique que dans certains états se replie quand il ne sert pas */
  type Show = (s: TweakState) => boolean

  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches
  /* clé VERSIONNÉE : un état persisté par une version antérieure du panneau ne doit
     jamais s'appliquer — c'est lui qui faisait paraître le mode invert « à l'envers » */
  const STORAGE_KEY = 'tweaks-ds-hero-pop-color.v3'

  /** a zone in the editor: `off` keeps it in the list but out of the render and the recipe */
  type EdZone = SpotMask & { off?: boolean }
  /** idle, drawing a new zone, or moving the points of zone `i` */
  type Tool = { kind: 'idle' } | { kind: 'draw' } | { kind: 'edit', i: number }

  const HUES = ['#c8321e', '#d2691e', '#d9a521', '#3f8f3a', '#1f8a7a', '#2f6fd0', '#7a5ae0', '#c0398f']
  const GROUNDS: Duo[] = [
    ['#14160f', '#4a4e3e'], /* olive   */
    ['#0a120b', '#36482c'], /* forêt   */
    ['#121212', '#454545'], /* charbon */
    ['#1c160c', '#5a4a30'], /* sépia   */
    ['#0f1722', '#3a4a5e'], /* ardoise */
  ]

  /* Les sources EN COULEUR du repo. Jamais les PNG déjà dithérés : la sélection se fait
     par teinte — une source monochrome ne fait rien popper. */
  /* un `dither` neuf part d'une trame contrastée, à régler ensuite dans la liste des zones */
  const ZONE_DUOS: Duo[] = [
    ['#0c0c0a', '#d8d2bc'], /* os      */
    ['#0a0a0a', '#f0ece0'], /* craie   */
    ['#1c160c', '#c9a45a'], /* laiton  */
    ...GROUNDS,
  ]

  interface Preset { label: string, src: string, recipe?: CoverRecipe }
  /** la recipe d'une cover d'article, telle que l'assemble le frontmatter du composant */
  type CoverRecipe = Partial<SpotHeroOptions> & {
    ink?: Rgb
    paper?: Rgb
    title?: string
    titleX?: string
    titleY?: string
    titleYMobile?: string
    titleInk?: 'light' | 'dark'
    height?: string
  }

  const PRESETS: Preset[] = [
    { label: 'bridge red', src: '/photos/source/bridge-red-web.jpg' },
    { label: 'castle blue', src: '/photos/source/castle-blue-web.jpg' },
    { label: 'zones demo', src: '/photos/source/trame-zones-web.jpg' },
    ...JSON.parse(document.getElementById('tw-panel')?.dataset.covers ?? '[]') as Preset[],
  ]

  const hero = document.querySelector<HTMLElement & { spotHero?: SpotHeroHandle }>('.post-hero')
  const heroImg = hero?.querySelector<HTMLImageElement>('img.dsrc') ?? null
  const ZONE_HELP = '« + Nouvelle zone », puis clique sur la photo pour poser ses points. Dans la liste : la case active ou désactive une zone, le menu choisit son type (In / Out règlent la couleur, Photo garde la photo nette, Dither lui donne sa trame), Arrondi passe le contour en courbe par les mêmes points, Éditer : glisse un point pour le déplacer, clique sur un bord pour ajouter un point, double-clique sur un point pour le retirer ; × supprime la zone.'
  const fade = hero?.nextElementSibling instanceof HTMLElement && hero.nextElementSibling.classList.contains('hero-fade')
    ? hero.nextElementSibling
    : null

  function hexToRgb(h: string): Rgb {
    const s = h.replace('#', '')
    return [Number.parseInt(s.slice(0, 2), 16), Number.parseInt(s.slice(2, 4), 16), Number.parseInt(s.slice(4, 6), 16)]
  }

  /* Les défauts SONT la recipe montée par la page : lue sur data-recipe, pas dupliquée. */
  const initialName = heroImg?.src.split('/').pop() ?? ''

  function toHex(c: Rgb): string {
    return `#${c.map(v => v.toString(16).padStart(2, '0')).join('')}`
  }

  /** `'18%'` → 18 ; absent ou illisible → `fallback` */
  function pct(v: string | undefined, fallback: number): number {
    const n = Number.parseFloat(v ?? '')
    return Number.isFinite(n) ? n : fallback
  }

  function defaultsFromMount(): TweakState {
    const r: CoverRecipe = JSON.parse(hero?.dataset.recipe ?? '{}')
    return stateFromRecipe(r, initialName, {
      title: hero?.querySelector('.ph-word')?.textContent?.trim() ?? 'Title',
      titleX: 4,
      titleY: 11,
      titleInk: hero?.dataset.titleInk === 'dark' ? 'dark' : 'light',
    })
  }

  function stateFromRecipe(r: CoverRecipe, name: string, type: Pick<TweakState, 'title' | 'titleX' | 'titleY' | 'titleInk'>): TweakState {
    return {
      mode: r.pop === false ? 'none' : r.invert ? 'invert' : 'pop',
      keep: r.keepSharp ? 'sharp' : 'dither',
      keepColor: typeof r.keepColor === 'string' ? r.keepColor : '#c8321e',
      threshold: r.hueLo ?? 34,
      softness: r.hueSpan ?? 62,
      pop: r.satBoost ?? 0.35,
      hueMode: r.hueMode ?? false,
      hueTol: r.hueTol ?? 20,
      hueSoft: r.hueSoft ?? 12,
      satMin: r.satMin ?? 40,
      satSoft: r.satSoft ?? 20,
      groundKind: r.ground ?? 'flat',
      groundMix: r.groundMix ?? 0,
      groundSat: r.groundSat ?? 1,
      groundLift: r.groundLift ?? 0,
      masks: r.masks?.length ? { [name]: structuredClone(r.masks) } : {},
      ground: [toHex(r.ink ?? [20, 22, 15]), toHex(r.paper ?? [74, 78, 62])],
      cell: r.cell ?? 3,
      contrast: r.contrast ?? 1.3,
      brightness: r.brightness ?? -0.02,
      shimmer: REDUCED ? 0 : (r.boil ?? 0.05),
      coverH: pct(r.height, 100),
      focalX: Math.round((r.focalX ?? 0.5) * 100),
      focalY: Math.round((r.focalY ?? 0.5) * 100),
      title: r.title ?? type.title,
      titleX: pct(r.titleX, type.titleX),
      titleY: pct(r.titleY, type.titleY),
      titleYMobile: pct(r.titleYMobile, pct(r.titleY, type.titleY)),
      titleInk: r.titleInk ?? type.titleInk,
    }
  }

  const DEFAULTS = defaultsFromMount()

  const KNOBS: Knob[] = [
    { sec: 'Source' },
    { k: 'image', type: 'image', label: 'Photo' },

    { sec: 'Selective colour' },
    { k: 'mode', type: 'seg', label: 'Mode', options: [['pop', 'Pop'], ['invert', 'Invert'], ['none', 'None']] },
    { k: 'keep', type: 'seg', label: 'Kept zone', options: [['dither', 'Dithered'], ['sharp', 'Sharp']] },
    { k: 'keepColor', type: 'swatch', label: 'Keep colour', options: HUES },
    { k: 'hueMode', type: 'toggle', label: 'Hue mode (angle)' },
    { k: 'threshold', type: 'range', label: 'Threshold', min: -40, max: 130, step: 1, when: s => !s.hueMode },
    { k: 'softness', type: 'range', label: 'Edge softness', min: 10, max: 160, step: 1, when: s => !s.hueMode },
    { k: 'hueTol', type: 'range', label: 'Hue tolerance', min: 0, max: 90, step: 1, unit: '°', when: s => s.hueMode },
    { k: 'hueSoft', type: 'range', label: 'Hue soft edge', min: 0, max: 60, step: 1, unit: '°', when: s => s.hueMode },
    { k: 'satMin', type: 'range', label: 'Min saturation', min: 0, max: 200, step: 1, when: s => s.hueMode },
    { k: 'satSoft', type: 'range', label: 'Saturation soft edge', min: 0, max: 100, step: 1, when: s => s.hueMode },
    { k: 'pop', type: 'range', label: 'Colour pop', min: 0, max: 1, step: 0.05 },

    { sec: 'Zones' },
    { type: 'zones', label: 'Draw on the cover' },

    { sec: 'Dithered ground' },
    { k: 'ground', type: 'duo', label: 'Tone', options: GROUNDS },
    { k: 'groundKind', type: 'seg', label: 'Off-cell ground', options: [['flat', 'Paper'], ['photo', 'Photo'], ['transparent', 'Clear']] },
    { k: 'groundMix', type: 'range', label: 'Mix toward paper', min: 0, max: 1, step: 0.05, when: s => s.groundKind === 'photo' },
    { k: 'groundSat', type: 'range', label: 'Photo saturation', min: 0, max: 1.5, step: 0.05, when: s => s.groundKind === 'photo' },
    { k: 'groundLift', type: 'range', label: 'Photo lift', min: -0.3, max: 0.6, step: 0.01, when: s => s.groundKind === 'photo' },
    { k: 'cell', type: 'range', label: 'Dot size', min: 2, max: 6, step: 1, unit: 'px' },
    { k: 'contrast', type: 'range', label: 'Contrast', min: 0.8, max: 1.8, step: 0.02 },
    { k: 'brightness', type: 'range', label: 'Brightness', min: -0.25, max: 0.25, step: 0.01 },
    { k: 'shimmer', type: 'range', label: 'Shimmer', min: 0, max: 0.18, step: 0.01 },

    { sec: 'Cover & type' },
    { k: 'coverH', type: 'range', label: 'Cover height', min: 60, max: 100, step: 1, unit: 'vh' },
    { k: 'focalX', type: 'range', label: 'Focal X', min: 0, max: 100, step: 1, unit: '%' },
    { k: 'focalY', type: 'range', label: 'Focal Y', min: 0, max: 100, step: 1, unit: '%' },
    { k: 'title', type: 'text', label: 'Title' },
    { k: 'titleX', type: 'range', label: 'Title X', min: 0, max: 70, step: 1, unit: '%' },
    { k: 'titleY', type: 'range', label: 'Title Y', min: 2, max: 62, step: 1, unit: '%' },
    { k: 'titleYMobile', type: 'range', label: 'Title Y mobile', min: 2, max: 90, step: 1, unit: '%' },
    { k: 'titleInk', type: 'seg', label: 'Title ink', options: [['light', 'Light'], ['dark', 'Dark']] },
  ]

  /* l'image chargée n'entre PAS dans l'état persisté : une data-URI de plusieurs Mo
     dépasserait le quota de localStorage */
  let loadedName = heroImg?.src.split('/').pop() ?? ''
  let loadedPreset: string | null = null

  function load(): TweakState {
    try {
      const raw = localStorage.getItem(STORAGE_KEY)
      const parsed: Partial<TweakState> = raw ? JSON.parse(raw) : {}
      // a state saved before the mobile knob places the mobile title like the desktop one
      const s: TweakState = { ...DEFAULTS, ...parsed, titleYMobile: parsed.titleYMobile ?? parsed.titleY ?? DEFAULTS.titleYMobile }
      // never share the masks object with DEFAULTS: editMasks() mutates it in place
      s.masks = structuredClone(s.masks)
      if (raw && REDUCED)
        s.shimmer = 0
      return s
    }
    catch {
      return { ...DEFAULTS, masks: structuredClone(DEFAULTS.masks) }
    }
  }
  function save(s: TweakState) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(s))
    }
    catch {}
  }

  /* un brouillon par photo, écrit à chaque modification : rechoisir la cover le reprend,
     même après un rechargement de la page ; Reset le jette et revient au fichier */
  const DRAFTS_KEY = 'tweaks-ds-hero-pop-color.drafts.v1'
  function drafts(): Record<string, TweakState> {
    try {
      return JSON.parse(localStorage.getItem(DRAFTS_KEY) ?? '{}')
    }
    catch {
      return {}
    }
  }
  function writeDrafts(d: Record<string, TweakState>) {
    try {
      localStorage.setItem(DRAFTS_KEY, JSON.stringify(d))
    }
    catch {}
  }
  /** the current photo's draft keeps only its own zones */
  function saveDraft(s: TweakState) {
    writeDrafts({ ...drafts(), [loadedName]: { ...s, masks: { [loadedName]: s.masks[loadedName] ?? [] } } })
  }
  function dropDraft() {
    const d = drafts()
    delete d[loadedName]
    writeDrafts(d)
  }

  function drawHeroTopo(ink: Rgb) {
    const topo = hero?.querySelector<HTMLCanvasElement>('canvas.topo-on')
    if (!topo)
      return
    Topo.draw(topo, {
      color: `rgba(${Math.min(255, ink[0] + 96)}, ${Math.min(255, ink[1] + 110)}, ${Math.min(255, ink[2] + 80)}, 0.22)`,
      levels: 16,
      cell: 18,
      scale: 0.003,
      seed: 9,
      emphasizeEvery: 4,
    })
  }

  /* le masque se rasterise à chaque envoi : on ne l'envoie que quand il a changé
     (édition de zone, changement de photo) */
  let masksDirty = true
  let draft: [number, number][] = []
  let tool: Tool = { kind: 'idle' }
  /** the point of the edited zone being dragged */
  let drag: number | null = null
  /** in edit mode, the edge under the pointer (from point k to k + 1), where a click inserts a point */
  let hoverSeg: number | null = null
  /** the last point pressed in edit mode, to catch a double click (the overlay redraws under the pointer, so dblclick never fires) */
  let lastPress: { k: number, t: number } | null = null

  function currentMasks(s: TweakState): EdZone[] {
    return s.masks[loadedName] ?? []
  }

  /** the zones the engine and the recipe see: active ones, without the editor flag */
  function liveMasks(s: TweakState): SpotMask[] {
    return currentMasks(s).filter(m => !m.off).map(({ off: _off, ...m }) => m)
  }

  function apply(s: TweakState) {
    if (!hero)
      return
    const ink = hexToRgb(s.ground[0])
    const paper = hexToRgb(s.ground[1])

    hero.spotHero?.update({
      cell: s.cell,
      ink,
      paper,
      contrast: s.contrast,
      brightness: s.brightness,
      boil: s.shimmer,
      keepColor: s.keepColor,
      hueLo: s.threshold,
      hueSpan: s.softness,
      satBoost: s.pop,
      invert: s.mode === 'invert',
      pop: s.mode !== 'none',
      keepSharp: s.keep === 'sharp',
      hueMode: s.hueMode,
      hueTol: s.hueTol,
      hueSoft: s.hueSoft,
      satMin: s.satMin,
      satSoft: s.satSoft,
      ground: s.groundKind,
      groundMix: s.groundMix,
      groundSat: s.groundSat,
      groundLift: s.groundLift,
      ...(masksDirty ? { masks: liveMasks(s) } : {}),
      focalX: s.focalX / 100,
      focalY: s.focalY / 100,
    })
    masksDirty = false
    drawHeroTopo(ink)

    /* les variables du composant sont posées en inline par define:vars — on les
       réécrit au même endroit, sur le hero ET sur son hero-fade */
    const h = `${s.coverH}vh`
    const heightChanged = hero.style.getPropertyValue('--phHeight') !== h
    for (const el of [hero, fade].filter((e): e is HTMLElement => e !== null)) {
      el.style.setProperty('--phHeight', h)
      el.style.setProperty('--phGround', paper.join(', '))
      el.style.setProperty('--phTitleX', `${s.titleX}%`)
      el.style.setProperty('--phTitleYBase', `${s.titleY}%`)
      el.style.setProperty('--phTitleYMobile', `${s.titleYMobile}%`)
    }
    /* la hauteur change clientHeight sans émettre de resize ; le moteur écoute resize */
    if (heightChanged)
      dispatchEvent(new Event('resize'))

    hero.dataset.titleInk = s.titleInk
    const word = hero.querySelector<HTMLElement>('.ph-word')
    if (word)
      word.textContent = s.title

    paint(s)
    writeRecipe(s)
    drawOverlay()
  }

  /* ---- la sortie : la recipe aux noms des props du composant ---- */
  function num(v: number): string {
    return Number.isInteger(v) ? String(v) : String(Number.parseFloat(v.toFixed(3)))
  }

  type Value = string | number | boolean | number[] | number[][]
  interface RecipeOut {
    spot: Record<string, Value | Record<string, Value>[]>
    word: string
    titleX?: string
    titleY: string
    titleYMobile: string
    titleInk: string
    height: string
    focal: { x: number, y: number }
  }

  /* one recipe, two outputs: the Copy snippet prints it, Save writes it into the post */
  function maskOut(m: SpotMask): Record<string, Value> {
    return {
      mode: m.mode,
      ...(m.mode === 'dither'
        ? {
            ...(Array.isArray(m.ink) ? { ink: m.ink } : {}),
            ...(Array.isArray(m.paper) ? { paper: m.paper } : {}),
            ...(m.contrast != null ? { contrast: +num(m.contrast) } : {}),
            ...(m.brightness != null ? { brightness: +num(m.brightness) } : {}),
            ...(m.cell != null ? { cell: +num(m.cell) } : {}),
          }
        : {}),
      ...(m.curve ? { curve: true } : {}),
      pts: m.pts.map(p => [+num(p[0]), +num(p[1])]),
    }
  }

  function recipeOf(s: TweakState): RecipeOut {
    const masks = liveMasks(s)
    return {
      spot: {
        keepColor: s.keepColor,
        ink: hexToRgb(s.ground[0]),
        paper: hexToRgb(s.ground[1]),
        cell: +num(s.cell),
        contrast: +num(s.contrast),
        brightness: +num(s.brightness),
        boil: +num(s.shimmer),
        ...(s.hueMode
          ? { hueMode: true, hueTol: +num(s.hueTol), hueSoft: +num(s.hueSoft), satMin: +num(s.satMin), satSoft: +num(s.satSoft) }
          : { hueLo: +num(s.threshold), hueSpan: +num(s.softness) }),
        satBoost: +num(s.pop),
        ...(s.mode === 'invert' ? { invert: true } : {}),
        ...(s.mode === 'none' ? { pop: false } : {}),
        ...(s.keep === 'sharp' ? { keepSharp: true } : {}),
        ...(s.groundKind !== 'flat' ? { ground: s.groundKind } : {}),
        ...(s.groundKind === 'photo'
          ? { groundMix: +num(s.groundMix), groundSat: +num(s.groundSat), groundLift: +num(s.groundLift) }
          : {}),
        ...(masks.length ? { masks: masks.map(maskOut) } : {}),
      },
      word: s.title,
      ...(s.titleX !== 4 ? { titleX: `${s.titleX}%` } : {}),
      titleY: `${s.titleY}%`,
      titleYMobile: `${s.titleYMobile}%`,
      titleInk: s.titleInk,
      height: `${s.coverH}vh`,
      focal: { x: +num(s.focalX / 100), y: +num(s.focalY / 100) },
    }
  }

  function lit(v: Value): string {
    if (typeof v === 'string')
      return `'${v}'`
    if (Array.isArray(v))
      return `[${v.map(x => lit(x as Value)).join(', ')}]`
    return typeof v === 'number' ? num(v) : String(v)
  }

  function recipeSnippet(s: TweakState): string {
    const r = recipeOf(s)
    const { masks, ...spot } = r.spot
    const zones = (masks ?? []) as Record<string, Value>[]
    return [
      'spot={{',
      ...Object.entries(spot).map(([k, v]) => `  ${k}: ${lit(v as Value)},`),
      ...(zones.length
        ? [
            '  masks: [',
            ...zones.map(m => `    { ${Object.entries(m).map(([k, v]) => `${k}: ${lit(v)}`).join(', ')} },`),
            '  ],',
          ]
        : []),
      '}}',
      `title="${r.word}"`,
      ...(r.titleX ? [`titleX="${r.titleX}"`] : []),
      `titleY="${r.titleY}"`,
      `titleYMobile="${r.titleYMobile}"`,
      `titleInk="${r.titleInk}"`,
      `height="${r.height}"`,
      `focal={{ x: ${num(r.focal.x)}, y: ${num(r.focal.y)} }}`,
      '',
      '// contraste du titre ≥3:1 MESURÉ (PIPELINE §4.6b).',
    ].join('\n')
  }

  function writeRecipe(s: TweakState) {
    const out = document.querySelector<HTMLTextAreaElement>('#tw-recipe')
    if (out)
      out.value = recipeSnippet(s)
  }

  /* ---- rendu du panneau depuis KNOBS ---- */
  function fmt(knob: Extract<Knob, { type: 'range' }>, v: number): string {
    const n = Number.isInteger(v) ? String(v) : v.toFixed(2)
    return n + (knob.unit ?? '')
  }

  function paint(s: TweakState) {
    for (const knob of KNOBS) {
      if (!('k' in knob) || knob.type === 'image')
        continue
      const host = document.getElementById(`k-${knob.k}`)
      if (!host)
        continue
      const rowEl = document.getElementById(`row-${knob.k}`)
      if (rowEl)
        rowEl.hidden = knob.when ? !knob.when(s) : false
      const v = s[knob.k]
      if (knob.type === 'range') {
        (host as HTMLInputElement).value = String(v)
        const val = document.getElementById(`v-${knob.k}`)
        if (val)
          val.textContent = fmt(knob, v as number)
      }
      else if (knob.type === 'text') {
        const input = host as HTMLInputElement
        if (input.value !== v)
          input.value = String(v)
      }
      else if (knob.type === 'swatch' || knob.type === 'duo') {
        const key = String(v)
        host.querySelectorAll('button').forEach(b =>
          b.setAttribute('aria-pressed', b.dataset.val === key ? 'true' : 'false'))
        if (knob.type === 'duo') {
          document.querySelectorAll<HTMLInputElement>(`#k-${knob.k}-pick input`).forEach((inp) => {
            const hex = (v as Duo)[Number(inp.dataset.side)]
            if (document.activeElement !== inp && inp.value !== hex)
              inp.value = hex
          })
        }
      }
      else if (knob.type === 'seg') {
        host.querySelectorAll('button').forEach(b =>
          b.setAttribute('aria-pressed', b.dataset.val === v ? 'true' : 'false'))
      }
      else if (knob.type === 'toggle') {
        (host as HTMLInputElement).checked = Boolean(v)
      }
    }
    paintZones(s)
  }

  const state = load()

  function commit<K extends keyof TweakState>(key: K, value: TweakState[K]) {
    state[key] = value
    save(state)
    saveDraft(state)
    apply(state)
  }

  /* ---- sonde de lisibilité : le moteur avale son échec (canvas contaminé) ---- */
  function pixelsReadable(img: HTMLImageElement): boolean {
    try {
      const c = document.createElement('canvas')
      c.width = 1
      c.height = 1
      const x = c.getContext('2d')!
      x.drawImage(img, 0, 0, 1, 1)
      x.getImageData(0, 0, 1, 1)
      return true
    }
    catch {
      return false
    }
  }

  function status() {
    const el = document.getElementById('tw-imgstatus')
    if (!el || !heroImg)
      return
    const w = heroImg.naturalWidth
    const h = heroImg.naturalHeight
    if (!w) {
      el.dataset.ok = 'yes'
      el.innerHTML = 'Chargement…'
      return
    }
    const ok = pixelsReadable(heroImg)
    el.dataset.ok = ok ? 'yes' : 'no'
    const dc = hero?.querySelector<HTMLCanvasElement>('canvas.dither-canvas')
    if (dc)
      dc.style.visibility = ok ? '' : 'hidden'
    el.innerHTML = ok
      ? `<b>${loadedName}</b> · ${w}×${h} · pixels lisibles`
      : `<b>Pixels illisibles</b> — ${loadedName} : canvas contaminé, le moteur ne peint pas. `
        + `Charge l'image par le sélecteur de fichier (data-URI), jamais contaminé.`
  }
  heroImg?.addEventListener('load', status)

  /* ---- chargeur d'image : un fichier local lu en data-URI ne contamine jamais ---- */
  function setImage(src: string, name: string) {
    if (!heroImg)
      return
    heroImg.src = src
    heroImg.alt = `Source photograph: ${name}`
    masksDirty = true
    draft = []
    paintPresets()
    status()
    syncPhone()
    syncSave()
  }

  function loadFile(file: File | null | undefined) {
    if (!file || !file.type.startsWith('image/'))
      return
    const fr = new FileReader()
    fr.onload = () => {
      loadedPreset = null
      loadedName = file.name
      setImage(String(fr.result), file.name)
    }
    fr.readAsDataURL(file)
  }

  function loadPreset(p: Preset) {
    loadedPreset = p.src
    loadedName = p.src.split('/').pop() ?? p.src
    const saved = drafts()[loadedName]
    if (saved) {
      // a draft of this photo wins over its file: the work in progress comes back
      // (a draft older than the mobile knob takes the file's mobile placement, else its desktop one)
      const fileMobile = p.recipe ? stateFromRecipe(p.recipe, loadedName, state).titleYMobile : undefined
      Object.assign(state, saved, {
        titleYMobile: saved.titleYMobile ?? fileMobile ?? saved.titleY,
        masks: { ...state.masks, [loadedName]: saved.masks[loadedName] ?? [] },
      })
      save(state)
    }
    else if (p.recipe) {
      // an article cover brings its whole recipe, zones included
      Object.assign(state, stateFromRecipe(p.recipe, loadedName, state), { shimmer: REDUCED ? 0 : (p.recipe.boil ?? 0.05) })
      save(state)
    }
    setImage(p.src, loadedName)
    if (saved || p.recipe)
      apply(state)
  }

  function paintPresets() {
    const host = document.getElementById('k-image-presets')
    host?.querySelectorAll('button').forEach(b =>
      b.setAttribute('aria-pressed', b.dataset.src === loadedPreset ? 'true' : 'false'))
  }

  /* déposer n'importe où sur la page, pas seulement sur le petit bouton */
  addEventListener('dragover', (e) => {
    e.preventDefault()
    document.querySelector<HTMLElement>('.tw-file')?.setAttribute('data-drag', 'on')
  })
  addEventListener('dragleave', () => {
    document.querySelector<HTMLElement>('.tw-file')?.removeAttribute('data-drag')
  })
  addEventListener('drop', (e) => {
    e.preventDefault()
    document.querySelector<HTMLElement>('.tw-file')?.removeAttribute('data-drag')
    loadFile(e.dataTransfer?.files?.[0])
  })

  function build() {
    const host = document.getElementById('tw-knobs')
    if (!host)
      return
    host.innerHTML = ''

    for (const knob of KNOBS) {
      if ('sec' in knob) {
        const h = document.createElement('div')
        h.className = 'tw-sec'
        h.textContent = knob.sec
        host.appendChild(h)
        continue
      }

      const row = document.createElement('div')
      row.className = 'tw-row'
      if ('k' in knob)
        row.id = `row-${knob.k}`

      const lbl = document.createElement('span')
      lbl.className = 'lbl'
      lbl.innerHTML = `<span>${knob.label}</span>`
      if (knob.type === 'range') {
        const val = document.createElement('span')
        val.className = 'val'
        val.id = `v-${knob.k}`
        lbl.appendChild(val)
      }
      row.appendChild(lbl)

      if (knob.type === 'range') {
        const r = document.createElement('input')
        r.type = 'range'
        r.className = 'tw-range'
        r.id = `k-${knob.k}`
        r.min = String(knob.min)
        r.max = String(knob.max)
        r.step = String(knob.step)
        r.setAttribute('aria-label', knob.label)
        r.addEventListener('input', () => commit(knob.k, Number.parseFloat(r.value) as never))
        row.appendChild(r)
      }
      else if (knob.type === 'text') {
        const t = document.createElement('input')
        t.type = 'text'
        t.className = 'tw-text'
        t.id = `k-${knob.k}`
        t.setAttribute('aria-label', knob.label)
        t.addEventListener('input', () => commit(knob.k, t.value as never))
        row.appendChild(t)
      }
      else if (knob.type === 'swatch') {
        const grid = document.createElement('div')
        grid.className = 'tw-swatches'
        grid.id = `k-${knob.k}`
        grid.setAttribute('role', 'radiogroup')
        grid.setAttribute('aria-label', knob.label)
        for (const hex of knob.options) {
          const b = document.createElement('button')
          b.type = 'button'
          b.className = 'tw-swatch'
          b.dataset.val = hex
          b.style.background = hex
          b.setAttribute('aria-label', hex)
          b.addEventListener('click', () => commit(knob.k, hex as never))
          grid.appendChild(b)
        }
        row.appendChild(grid)
      }
      else if (knob.type === 'duo') {
        const grid = document.createElement('div')
        grid.className = 'tw-swatches duo'
        grid.id = `k-${knob.k}`
        grid.setAttribute('role', 'radiogroup')
        grid.setAttribute('aria-label', knob.label)
        for (const pair of knob.options) {
          const b = document.createElement('button')
          b.type = 'button'
          b.className = 'tw-swatch'
          b.dataset.val = String(pair)
          b.style.background = `linear-gradient(105deg, ${pair[0]} 0 50%, ${pair[1]} 50% 100%)`
          b.setAttribute('aria-label', pair.join(' / '))
          b.addEventListener('click', () => commit(knob.k, pair as never))
          grid.appendChild(b)
        }
        row.appendChild(grid)
        const picks = colorPair(knob.label, state[knob.k] as Duo, p => commit(knob.k, p as never), true)
        picks.id = `k-${knob.k}-pick`
        row.appendChild(picks)
      }
      else if (knob.type === 'image') {
        const pick = document.createElement('label')
        pick.className = 'tw-file'
        pick.textContent = 'Choose file · or drop anywhere'
        const inp = document.createElement('input')
        inp.type = 'file'
        inp.accept = 'image/*'
        inp.addEventListener('change', () => loadFile(inp.files?.[0]))
        pick.appendChild(inp)
        row.appendChild(pick)

        const grid = document.createElement('div')
        grid.className = 'tw-presets'
        grid.id = 'k-image-presets'
        grid.setAttribute('role', 'radiogroup')
        grid.setAttribute('aria-label', 'Project sources')
        for (const p of PRESETS) {
          const b = document.createElement('button')
          b.type = 'button'
          b.dataset.src = p.src
          b.textContent = p.label
          b.title = p.src
          b.addEventListener('click', () => loadPreset(p))
          grid.appendChild(b)
        }
        row.appendChild(grid)
      }
      else if (knob.type === 'toggle') {
        const t = document.createElement('input')
        t.type = 'checkbox'
        t.className = 'tw-check'
        t.id = `k-${knob.k}`
        t.setAttribute('aria-label', knob.label)
        t.addEventListener('change', () => commit(knob.k, t.checked as never))
        row.appendChild(t)
      }
      else if (knob.type === 'zones') {
        const help = document.createElement('p')
        help.className = 'tw-hint'
        help.textContent = ZONE_HELP
        row.appendChild(help)
        const seg = document.createElement('div')
        seg.className = 'tw-seg'
        const add = document.createElement('button')
        add.type = 'button'
        add.id = 'k-zonenew'
        add.textContent = '+ Nouvelle zone'
        add.addEventListener('click', () => setTool(tool.kind === 'draw' ? { kind: 'idle' } : { kind: 'draw' }))
        seg.appendChild(add)
        row.appendChild(seg)
        const hint = document.createElement('p')
        hint.className = 'tw-hint'
        hint.id = 'k-zonehint'
        row.appendChild(hint)
        const list = document.createElement('div')
        list.className = 'tw-zones'
        list.id = 'k-zonelist'
        row.appendChild(list)
      }
      else if (knob.type === 'seg') {
        const seg = document.createElement('div')
        seg.className = 'tw-seg'
        seg.id = `k-${knob.k}`
        seg.setAttribute('role', 'radiogroup')
        seg.setAttribute('aria-label', knob.label)
        for (const [val, label] of knob.options) {
          const b = document.createElement('button')
          b.type = 'button'
          b.dataset.val = val
          b.textContent = label
          b.addEventListener('click', () => commit(knob.k, val as never))
          seg.appendChild(b)
        }
        row.appendChild(seg)
      }

      host.appendChild(row)
    }
  }

  /* ---- éditeur de zones ----
     Les polygones sont stockés en coordonnées normalisées sur l'IMAGE (comme le moteur les
     attend) ; l'overlay les projette en px du hero avec le même cover-fit que le moteur. */
  const SVGNS = 'http://www.w3.org/2000/svg'
  const overlay = document.getElementById('tw-ov') as unknown as SVGSVGElement | null
  let cursor: [number, number] | null = null
  /** index of the zone hovered in the panel list, highlighted on the photo */
  let hoverZone: number | null = null

  if (overlay && hero)
    hero.appendChild(overlay)

  /* le même cover-fit que `build()` du moteur, en px du hero : sx/sy = taille d'une cellule */
  function coverFit() {
    if (!hero || !heroImg || !heroImg.naturalWidth)
      return null
    const cw = hero.clientWidth || 320
    const ch = hero.clientHeight || 240
    const lw = Math.max(1, Math.floor(cw / state.cell))
    const lh = Math.max(1, Math.floor(ch / state.cell))
    const ir = heroImg.naturalWidth / heroImg.naturalHeight
    const fx = state.focalX / 100
    const fy = state.focalY / 100
    let dw: number
    let dh: number
    let dx: number
    let dy: number
    if (ir > lw / lh) {
      dh = lh
      dw = lh * ir
      dx = (lw - dw) * fx
      dy = 0
    }
    else {
      dw = lw
      dh = lw / ir
      dx = 0
      dy = (lh - dh) * fy
    }
    return { cw, ch, sx: cw / lw, sy: ch / lh, dx, dy, dw, dh }
  }

  function toFrame(f: NonNullable<ReturnType<typeof coverFit>>, p: [number, number]): [number, number] {
    return [(f.dx + p[0] * f.dw) * f.sx, (f.dy + p[1] * f.dh) * f.sy]
  }

  function toImg(f: NonNullable<ReturnType<typeof coverFit>>, x: number, y: number): [number, number] {
    const nx = (x / f.sx - f.dx) / f.dw
    const ny = (y / f.sy - f.dy) / f.dh
    return [Math.min(1, Math.max(0, nx)), Math.min(1, Math.max(0, ny))]
  }

  function svgEl<K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string>) {
    const el = document.createElementNS(SVGNS, tag)
    for (const [k, v] of Object.entries(attrs))
      el.setAttribute(k, v)
    return el
  }

  /** a zone's outline as an SVG path, traced by the engine's own `traceZone` */
  function zoneD(pts: [number, number][], curve?: boolean): string {
    const d: string[] = []
    traceZone({
      moveTo: (x, y) => d.push(`M${x} ${y}`),
      lineTo: (x, y) => d.push(`L${x} ${y}`),
      bezierCurveTo: (a, b, c, e, x, y) => d.push(`C${a} ${b} ${c} ${e} ${x} ${y}`),
      closePath: () => d.push('Z'),
    }, pts, curve)
    return d.join('')
  }

  /* l'overlay ne montre que le contour : le remplissage reste léger pour voir le rendu */
  const ZONE_STYLE: Record<SpotMask['mode'], Record<string, string>> = {
    in: { 'fill': 'rgba(196, 106, 62, 0.28)', 'stroke': '#c46a3e', 'stroke-width': '2' },
    out: { 'fill': 'rgba(255, 255, 255, 0.18)', 'stroke': '#fff', 'stroke-width': '2', 'stroke-dasharray': '6 4' },
    photo: { 'fill': 'none', 'stroke': '#7fd3ff', 'stroke-width': '2' },
    dither: { 'fill': 'none', 'stroke': '#ffd75e', 'stroke-width': '2', 'stroke-dasharray': '2 3' },
  }
  const ZONE_LABEL: Record<SpotMask['mode'], string> = { in: 'In', out: 'Out', photo: 'Photo', dither: 'Dither' }

  function setHoverZone(i: number | null) {
    hoverZone = i
    drawOverlay()
  }

  /* while drawing or editing, the cover shows the source photo without its screen, framed like the engine */
  function showRawPhoto(raw: boolean) {
    for (const c of hero?.querySelectorAll<HTMLCanvasElement>('canvas.dither-canvas, canvas.topo-on') ?? [])
      c.style.visibility = raw ? 'hidden' : ''
    if (heroImg)
      heroImg.style.objectPosition = raw ? `${state.focalX}% ${state.focalY}%` : ''
  }

  function drawOverlay() {
    if (!overlay)
      return
    overlay.replaceChildren()
    const busy = tool.kind !== 'idle'
    showRawPhoto(busy)
    const f = coverFit()
    if (!f || (!busy && hoverZone === null))
      return
    overlay.setAttribute('viewBox', `0 0 ${f.cw} ${f.ch}`)
    const editing = tool.kind === 'edit' ? tool.i : null
    currentMasks(state).forEach((m, i) => {
      if (!busy && i !== hoverZone)
        return
      const d = zoneD(m.pts.map(p => toFrame(f, p)), m.curve)
      const hot = i === hoverZone || i === editing ? { 'fill': 'rgba(255, 255, 255, 0.35)', 'stroke-width': '4' } : {}
      const dim = m.off && i !== editing ? { opacity: '0.4' } : {}
      overlay.appendChild(svgEl('path', { d, ...ZONE_STYLE[m.mode], ...hot, ...dim }))
    })
    if (editing !== null && hoverSeg !== null) {
      const pts = currentMasks(state)[editing]?.pts ?? []
      const [a, b] = [pts[hoverSeg], pts[(hoverSeg + 1) % pts.length]].map(p => toFrame(f, p))
      if (a && b)
        overlay.appendChild(svgEl('line', { 'x1': String(a[0]), 'y1': String(a[1]), 'x2': String(b[0]), 'y2': String(b[1]), 'stroke': '#c46a3e', 'stroke-width': '5' }))
    }
    if (editing !== null) {
      for (const p of currentMasks(state)[editing]?.pts ?? []) {
        const [x, y] = toFrame(f, p)
        overlay.appendChild(svgEl('circle', { 'cx': String(x), 'cy': String(y), 'r': '6', 'fill': '#fff', 'stroke': '#000', 'stroke-width': '1.5' }))
      }
    }
    if (draft.length) {
      const pts = [...draft, ...(cursor ? [cursor] : [])].map(p => toFrame(f, p).join(','))
      overlay.appendChild(svgEl('polyline', { 'points': pts.join(' '), 'fill': 'none', 'stroke': '#fff', 'stroke-width': '2' }))
      draft.forEach((p, i) => {
        const [x, y] = toFrame(f, p)
        overlay.appendChild(svgEl('circle', { 'cx': String(x), 'cy': String(y), 'r': i === 0 ? '6' : '3.5', 'fill': i === 0 ? '#c46a3e' : '#fff', 'stroke': '#000', 'stroke-width': '1' }))
      })
    }
  }

  /** a zone of another type: a dither zone gets a default screen, the others keep only their points */
  function retype(m: EdZone, mode: SpotMask['mode']): EdZone {
    const base = { mode, pts: m.pts, ...(m.curve ? { curve: true } : {}), ...(m.off ? { off: true } : {}) }
    if (mode !== 'dither')
      return base
    const [ink, paper] = ZONE_DUOS[0]
    return { ink: hexToRgb(ink), paper: hexToRgb(paper), contrast: 1.6, cell: state.cell, ...m, ...base }
  }

  function paintZones(s: TweakState) {
    const add = document.getElementById('k-zonenew')
    add?.setAttribute('aria-pressed', String(tool.kind === 'draw'))
    const hint = document.getElementById('k-zonehint')
    if (hint) {
      hint.textContent = tool.kind === 'draw'
        ? 'Nouvelle zone : clique pour poser les points · Entrée ou clic sur le premier point ferme · Retour arrière enlève un point · Échap annule'
        : tool.kind === 'edit'
          ? `Zone ${tool.i + 1} : glisse un point · clic sur un bord = nouveau point · double-clic sur un point = le retirer (3 au moins) · OK ou Échap termine`
          : ''
      hint.hidden = tool.kind === 'idle'
    }
    const list = document.getElementById('k-zonelist')
    if (!list)
      return
    list.replaceChildren()
    const ms = currentMasks(s)
    ms.forEach((m, i) => {
      const item = document.createElement('div')
      item.className = 'tw-zone'
      item.addEventListener('pointerenter', () => setHoverZone(i))
      item.addEventListener('pointerleave', () => setHoverZone(null))

      const on = document.createElement('input')
      on.type = 'checkbox'
      on.checked = !m.off
      on.setAttribute('aria-label', `Zone ${i + 1} active`)
      on.addEventListener('change', () => editMasks(ms.map((z, j) => j === i ? { ...z, off: !on.checked || undefined } : z)))

      const name = document.createElement('span')
      name.textContent = `Zone ${i + 1}`

      const type = document.createElement('select')
      type.setAttribute('aria-label', `Zone ${i + 1} type`)
      for (const mode of ['in', 'out', 'photo', 'dither'] as const)
        type.add(new Option(ZONE_LABEL[mode], mode, false, mode === m.mode))
      type.addEventListener('change', () => editMasks(ms.map((z, j) => j === i ? retype(z, type.value as SpotMask['mode']) : z)))

      const editing = tool.kind === 'edit' && tool.i === i
      const edit = document.createElement('button')
      edit.type = 'button'
      edit.textContent = editing ? 'OK' : 'Éditer'
      edit.setAttribute('aria-pressed', String(editing))
      edit.addEventListener('click', () => setTool(editing ? { kind: 'idle' } : { kind: 'edit', i }))

      const round = document.createElement('button')
      round.type = 'button'
      round.textContent = 'Arrondi'
      round.title = 'Contour arrondi : une courbe qui passe par les points'
      round.setAttribute('aria-pressed', String(!!m.curve))
      round.setAttribute('aria-label', `Zone ${i + 1} rounded`)
      round.addEventListener('click', () => editMasks(ms.map((z, j) => j === i ? { ...z, curve: !z.curve || undefined } : z)))

      const del = document.createElement('button')
      del.type = 'button'
      del.textContent = '×'
      del.setAttribute('aria-label', `Delete zone ${i + 1}`)
      del.addEventListener('click', () => {
        hoverZone = null
        if (tool.kind === 'edit')
          tool = { kind: 'idle' }
        editMasks(ms.filter((_, j) => j !== i))
      })
      item.append(on, name, type, round, edit, del)
      list.appendChild(item)
      if (m.mode === 'dither')
        list.appendChild(zoneScreen(s, ms, i))
    })
  }

  /* Free colours: ink and paper picked by hand, past the presets. Only a pick changes
     anything: a recipe that was never touched keeps its values. `live` repaints while
     the picker moves; otherwise the pick lands when it closes (a zone's list is rebuilt
     on each change, which would close the picker under the cursor). */
  function colorPair(label: string, pair: Duo, pick: (pair: Duo) => void, live: boolean): HTMLElement {
    const row = document.createElement('div')
    row.className = 'tw-pick'
    ;(['Encre', 'Papier'] as const).forEach((name, i) => {
      const l = document.createElement('label')
      const inp = document.createElement('input')
      inp.type = 'color'
      inp.value = pair[i]
      inp.dataset.side = String(i)
      inp.setAttribute('aria-label', `${label} ${name.toLowerCase()}`)
      // the pair is read from both inputs at pick time: the panel keeps them in step with the state
      inp.addEventListener(live ? 'input' : 'change', () =>
        pick([...row.querySelectorAll('input')].map(x => x.value) as Duo))
      l.append(inp, name)
      row.appendChild(l)
    })
    return row
  }

  /** the controls of a `dither` zone's own screen; unset fields read the global ones */
  function zoneScreen(s: TweakState, ms: SpotMask[], i: number): HTMLElement {
    const m = ms[i]
    const set = (patch: Partial<SpotMask>) => editMasks(ms.map((z, j) => j === i ? { ...z, ...patch } : z))
    const box = document.createElement('div')
    box.className = 'tw-zonescreen'

    const duo = document.createElement('div')
    duo.className = 'tw-swatches duo'
    duo.setAttribute('role', 'radiogroup')
    duo.setAttribute('aria-label', `Zone ${i + 1} tone`)
    const cur = [Array.isArray(m.ink) ? toHex(m.ink as Rgb) : s.ground[0], Array.isArray(m.paper) ? toHex(m.paper as Rgb) : s.ground[1]].join()
    for (const pair of ZONE_DUOS) {
      const b = document.createElement('button')
      b.type = 'button'
      b.className = 'tw-swatch'
      b.style.background = `linear-gradient(105deg, ${pair[0]} 0 50%, ${pair[1]} 50% 100%)`
      b.setAttribute('aria-label', pair.join(' / '))
      b.setAttribute('aria-pressed', String(pair.join() === cur))
      b.addEventListener('click', () => set({ ink: hexToRgb(pair[0]), paper: hexToRgb(pair[1]) }))
      duo.appendChild(b)
    }
    box.appendChild(duo)
    box.appendChild(colorPair(`Zone ${i + 1}`, cur.split(',') as Duo, p => set({ ink: hexToRgb(p[0]), paper: hexToRgb(p[1]) }), false))

    const ranges: [keyof SpotMask & ('contrast' | 'brightness' | 'cell'), string, number, number, number, number][] = [
      ['contrast', 'Contrast', 0.8, 2.4, 0.02, s.contrast],
      ['brightness', 'Brightness', -0.3, 0.3, 0.01, s.brightness],
      ['cell', 'Dot size', s.cell, s.cell * 4, s.cell, s.cell],
    ]
    for (const [k, label, min, max, step, fallback] of ranges) {
      const row = document.createElement('label')
      row.className = 'tw-zonerange'
      const v = m[k] ?? fallback
      const txt = document.createElement('span')
      txt.textContent = `${label} ${Number.isInteger(v) ? v : v.toFixed(2)}`
      const r = document.createElement('input')
      r.type = 'range'
      r.className = 'tw-range'
      r.min = String(min)
      r.max = String(max)
      r.step = String(step)
      r.value = String(v)
      r.setAttribute('aria-label', `Zone ${i + 1} ${label}`)
      r.addEventListener('change', () => set({ [k]: Number.parseFloat(r.value) }))
      row.append(txt, r)
      box.appendChild(row)
    }
    return box
  }

  function editMasks(next: EdZone[]) {
    if (next.length)
      state.masks[loadedName] = next
    else
      delete state.masks[loadedName]
    masksDirty = true
    save(state)
    saveDraft(state)
    apply(state)
  }

  function setTool(t: Tool) {
    tool = t
    draft = []
    cursor = null
    drag = null
    hoverSeg = null
    lastPress = null
    if (overlay)
      overlay.style.pointerEvents = t.kind === 'idle' ? 'none' : 'auto'
    drawOverlay()
    paintZones(state)
  }

  /** a new zone is always added; its type is set afterwards in its row */
  function closeDraft() {
    if (draft.length >= 3 && tool.kind === 'draw') {
      const pts = draft
      draft = []
      cursor = null
      tool = { kind: 'idle' }
      if (overlay)
        overlay.style.pointerEvents = 'none'
      editMasks([...currentMasks(state), { mode: 'photo', pts }])
      return
    }
    drawOverlay()
  }

  function overlayPoint(e: PointerEvent, f: NonNullable<ReturnType<typeof coverFit>>): [number, number] {
    const r = overlay!.getBoundingClientRect()
    return [(e.clientX - r.left) * (f.cw / r.width), (e.clientY - r.top) * (f.ch / r.height)]
  }

  /** the point of the edited zone under (x, y), in hero px */
  function pointAt(f: NonNullable<ReturnType<typeof coverFit>>, pts: [number, number][], x: number, y: number): number {
    return pts.findIndex(p => Math.hypot(toFrame(f, p)[0] - x, toFrame(f, p)[1] - y) < 12)
  }

  /** the edge of the edited zone under (x, y), away from its points */
  function segmentAt(f: NonNullable<ReturnType<typeof coverFit>>, pts: [number, number][], x: number, y: number): number | null {
    if (pointAt(f, pts, x, y) >= 0)
      return null
    let best: number | null = null
    let bestD = 8
    pts.forEach((p, k) => {
      const [ax, ay] = toFrame(f, p)
      const [bx, by] = toFrame(f, pts[(k + 1) % pts.length])
      const len2 = (bx - ax) ** 2 + (by - ay) ** 2
      const t = len2 ? Math.min(1, Math.max(0, ((x - ax) * (bx - ax) + (y - ay) * (by - ay)) / len2)) : 0
      const d = Math.hypot(ax + t * (bx - ax) - x, ay + t * (by - ay) - y)
      if (d < bestD) {
        bestD = d
        best = k
      }
    })
    return best
  }

  overlay?.addEventListener('pointerdown', (e) => {
    const f = coverFit()
    if (!f || tool.kind === 'idle')
      return
    e.preventDefault()
    /* a panel button keeps focus otherwise, and Enter would press it instead of closing */
    if (document.activeElement instanceof HTMLElement)
      document.activeElement.blur()
    const [x, y] = overlayPoint(e, f)
    if (tool.kind === 'edit') {
      const z = currentMasks(state)[tool.i]
      if (!z)
        return
      const near = pointAt(f, z.pts, x, y)
      const double = near >= 0 && lastPress?.k === near && e.timeStamp - lastPress.t < 400
      lastPress = near >= 0 && !double ? { k: near, t: e.timeStamp } : null
      if (double) {
        if (z.pts.length > 3) {
          const i = tool.i
          editMasks(currentMasks(state).map((m, j) => j === i ? { ...m, pts: m.pts.filter((_, k) => k !== near) } : m))
        }
        return
      }
      const seg = near < 0 ? segmentAt(f, z.pts, x, y) : null
      if (seg !== null) {
        z.pts = [...z.pts.slice(0, seg + 1), toImg(f, x, y), ...z.pts.slice(seg + 1)]
        hoverSeg = null
      }
      drag = seg !== null ? seg + 1 : near >= 0 ? near : null
      if (drag !== null)
        overlay.setPointerCapture(e.pointerId)
      drawOverlay()
      return
    }
    if (draft.length >= 3) {
      const [fx, fy] = toFrame(f, draft[0])
      if (Math.hypot(fx - x, fy - y) < 12) {
        closeDraft()
        return
      }
    }
    draft.push(toImg(f, x, y))
    drawOverlay()
  })

  overlay?.addEventListener('pointermove', (e) => {
    const f = coverFit()
    if (!f)
      return
    const [x, y] = overlayPoint(e, f)
    if (tool.kind === 'edit' && drag !== null) {
      const ms = currentMasks(state)
      const z = ms[tool.i]
      z.pts = z.pts.map((p, k) => k === drag ? toImg(f, x, y) : p)
      drawOverlay()
      return
    }
    if (tool.kind === 'edit') {
      const seg = segmentAt(f, currentMasks(state)[tool.i]?.pts ?? [], x, y)
      if (seg !== hoverSeg) {
        hoverSeg = seg
        drawOverlay()
      }
      return
    }
    if (!draft.length)
      return
    cursor = toImg(f, x, y)
    drawOverlay()
  })

  overlay?.addEventListener('pointerup', () => {
    if (drag === null)
      return
    drag = null
    editMasks([...currentMasks(state)])
  })

  addEventListener('keydown', (e) => {
    if (tool.kind === 'idle')
      return
    if (e.key === 'Escape') {
      e.preventDefault()
      setTool({ kind: 'idle' })
      return
    }
    if ((e.target as HTMLElement).matches('input, textarea, select, button, [contenteditable]'))
      return
    if (tool.kind !== 'draw')
      return
    if (e.key === 'Enter') {
      e.preventDefault()
      closeDraft()
    }
    else if (e.key === 'Backspace') {
      e.preventDefault()
      draft.pop()
      drawOverlay()
    }
  })

  addEventListener('resize', drawOverlay)
  heroImg?.addEventListener('load', drawOverlay)

  /* ---- ouverture : replié par défaut (la preview d'abord), la pastille T le rappelle ---- */
  const panel = document.getElementById('tw-panel')!
  const restore = document.getElementById('tw-restore')!

  function setPanelVisible(v: boolean) {
    panel.classList.toggle('tw-hidden', !v)
    restore.classList.toggle('tw-show', !v)
  }
  document.getElementById('tw-close')?.addEventListener('click', () => setPanelVisible(false))
  restore.addEventListener('click', () => setPanelVisible(true))

  /* the panel moves, dragged by its header */
  const head = panel.querySelector<HTMLElement>('.tw-head')!
  let grab: { dx: number, dy: number } | null = null
  head.addEventListener('pointerdown', (e) => {
    if ((e.target as HTMLElement).closest('button'))
      return
    const r = panel.getBoundingClientRect()
    grab = { dx: e.clientX - r.left, dy: e.clientY - r.top }
    head.setPointerCapture(e.pointerId)
    e.preventDefault()
  })
  head.addEventListener('pointermove', (e) => {
    if (!grab)
      return
    const x = Math.min(Math.max(0, e.clientX - grab.dx), innerWidth - 40)
    const y = Math.min(Math.max(0, e.clientY - grab.dy), innerHeight - 40)
    Object.assign(panel.style, { left: `${x}px`, top: `${y}px`, right: 'auto', width: `${panel.offsetWidth}px` })
  })
  head.addEventListener('pointerup', () => {
    grab = null
  })

  function reset() {
    dropDraft()
    setTool({ kind: 'idle' })
    const p = PRESETS.find(x => x.src === loadedPreset)
    if (p?.recipe) {
      // an article cover goes back to its file
      loadPreset(p)
      return
    }
    Object.assign(state, DEFAULTS, { masks: structuredClone(DEFAULTS.masks) })
    masksDirty = true
    save(state)
    apply(state)
  }
  document.getElementById('tw-reset')?.addEventListener('click', reset)

  /* ---- copie de la recipe ---- */
  const copyBtn = document.getElementById('tw-copy')!
  const outBox = document.querySelector<HTMLTextAreaElement>('#tw-recipe')!

  function flash(label: string) {
    copyBtn.textContent = label
    copyBtn.dataset.done = 'on'
    setTimeout(() => {
      copyBtn.textContent = 'Copy recipe'
      delete copyBtn.dataset.done
    }, 1400)
  }

  copyBtn.addEventListener('click', async () => {
    const text = recipeSnippet(state)
    try {
      await navigator.clipboard.writeText(text)
      flash('Copied')
      return
    }
    catch { /* refusé — replis */ }
    const details = outBox.closest('details')
    if (details)
      details.open = true
    outBox.focus()
    outBox.select()
    flash('Select + ⌘C')
  })

  /* ---- Save (dev only): write the recipe into a post's `cover:` block ----
       The endpoint is the dev server's (scripts/cover-save.mjs); in a build this whole block
       is dead code and the controls are not rendered. The recipe sent is recipeOf(), the very
       one Copy prints. A dropped photo can only be saved if the repo has it under the same
       name in public/photos/source/: the editor never moves a file. */
  interface SavePost { slug: string, lang: string, translation?: string, src?: string, hasAlt: boolean }
  const saveBox = import.meta.env.DEV ? document.getElementById('tw-save') : null
  const savePosts: SavePost[] = JSON.parse(saveBox?.dataset.posts ?? '[]')
  const REOPEN_KEY = 'tweaks-ds-hero-pop-color.reopen'
  /** dropped file name → its repo path, or null when the repo does not have it */
  const repoPhotos = new Map<string, string | null>()
  let savedFor: string | null = null

  /** the repo path of the photo on screen, `undefined` while a dropped file is being looked up */
  function photoSrc(): string | null | undefined {
    if (loadedPreset?.startsWith('/photos/source/'))
      return loadedPreset
    if (loadedPreset)
      return null
    return repoPhotos.get(loadedName)
  }

  function syncSave() {
    if (!saveBox)
      return
    const select = document.querySelector<HTMLSelectElement>('#tw-save-post')!
    const btn = document.querySelector<HTMLButtonElement>('#tw-save-btn')!
    const msg = document.getElementById('tw-save-msg')!
    const say = (text: string, bad = false) => {
      msg.textContent = text
      if (bad)
        msg.dataset.tone = 'bad'
      else
        delete msg.dataset.tone
    }

    if (!select.options.length) {
      select.add(new Option('Choisir l\'article…', ''))
      for (const p of savePosts)
        select.add(new Option(`${p.slug} · ${p.lang}`, p.slug))
    }
    let src = photoSrc()
    const looking = src === undefined
    if (looking) {
      // a dropped file: is it a photo of the repo, under the same name?
      const name = loadedName
      const path = `/photos/source/${name}`
      repoPhotos.set(name, null)
      fetch(path, { method: 'HEAD' })
        .then(r => repoPhotos.set(name, r.ok && (r.headers.get('content-type') ?? '').startsWith('image/') ? path : null))
        .catch(() => {})
        .finally(() => {
          if (loadedName === name)
            syncSave()
        })
      src = null
    }
    // a new photo selects the post whose cover it is
    if (src !== savedFor) {
      savedFor = src
      const owner = src ? (savePosts.find(p => p.src === src && p.lang === 'en') ?? savePosts.find(p => p.src === src)) : undefined
      // no owner: no guess, the post is picked by hand
      select.value = owner ? owner.slug : ''
    }

    const post = savePosts.find(p => p.slug === select.value)
    const other = post?.translation ? savePosts.find(p => p.slug === post.translation) : undefined
    const both = document.querySelector<HTMLInputElement>('#tw-save-both')!
    document.getElementById('tw-save-both-row')!.hidden = !other
    document.getElementById('tw-save-both-label')!.textContent = other ? `+ traduction (${other.slug} · ${other.lang})` : ''
    const needsAlt = !!post && (!post.hasAlt || (!!other && both.checked && !other.hasAlt))
    document.getElementById('tw-save-alt-row')!.hidden = !needsAlt

    if (!src) {
      btn.disabled = true
      say(!looking
        ? `Photo hors du repo : ${loadedName} n'est pas dans public/photos/source/. Copie-la là sous ce nom, puis redépose-la ; l'éditeur ne déplace aucun fichier.`
        : `Recherche de ${loadedName} dans le repo…`, true)
      return
    }
    btn.disabled = !post
    say(post ? `${src} → cover de ${post.slug}${other && both.checked ? ` et de ${other.slug}` : ''}` : `${src} : choisis l'article où l'écrire.`)
  }

  if (saveBox) {
    const select = document.querySelector<HTMLSelectElement>('#tw-save-post')!
    const both = document.querySelector<HTMLInputElement>('#tw-save-both')!
    const alt = document.querySelector<HTMLInputElement>('#tw-save-alt')!
    const btn = document.querySelector<HTMLButtonElement>('#tw-save-btn')!
    const msg = document.getElementById('tw-save-msg')!
    select.addEventListener('change', syncSave)
    both.addEventListener('change', syncSave)
    btn.addEventListener('click', async () => {
      const src = photoSrc()
      const post = savePosts.find(p => p.slug === select.value)
      if (!src || !post)
        return
      const translation = !document.getElementById('tw-save-both-row')!.hidden && both.checked
      btn.disabled = true
      msg.textContent = 'Écriture…'
      delete msg.dataset.tone
      try {
        const res = await fetch('/__cover-save', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ slug: post.slug, translation, src, alt: alt.value.trim() || undefined, recipe: recipeOf(state) }),
        })
        const data = await res.json() as { files?: string[], error?: string }
        if (!res.ok || !data.files)
          throw new Error(data.error ?? `HTTP ${res.status}`)
          // the file is now the reference: its draft goes, and the editor reopens this photo
          // if the dev server reloads the page for the content change
        dropDraft()
        const done = `Écrit : ${data.files.join(', ')}`
        sessionStorage.setItem(REOPEN_KEY, JSON.stringify({ src, done, at: Date.now() }))
        msg.textContent = done
      }
      catch (e) {
        msg.textContent = `Pas écrit : ${e instanceof Error ? e.message : String(e)}`
        msg.dataset.tone = 'bad'
      }
      finally {
        btn.disabled = false
      }
    })
  }

  /* ---- raccourcis ---- */
  addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey)
      return
    const t = e.target as HTMLElement
    if (t.matches('input, textarea, select, [contenteditable]'))
      return
    if (e.key === 't' || e.key === 'T') {
      e.preventDefault()
      setPanelVisible(panel.classList.contains('tw-hidden'))
    }
    else if (e.key === 'r' || e.key === 'R') {
      e.preventDefault()
      reset()
    }
  })

  /* ---- aperçu mobile : cette page dans un cadre de 390 px, en mode `?phone=<photo>` ----
     Le cadre a sa propre largeur de viewport : les vrais breakpoints du composant
     (≤700px, taille du titre en vw) s'y appliquent. Il lit l'état que le panneau écrit
     dans localStorage et le suit par l'événement `storage` ; il n'écrit jamais rien. */
  const PHONE = new URLSearchParams(location.search).get('phone')
  const phoneFrame = document.getElementById('tw-phone-frame')!
  const phoneView = document.querySelector<HTMLIFrameElement>('#tw-phone-view')!
  const phoneBtn = document.getElementById('tw-phone')!

  function syncPhone() {
    if (PHONE !== null || phoneFrame.hidden)
      return
    const src = `${location.pathname}?phone=${encodeURIComponent(loadedPreset ?? '')}`
    if (phoneView.getAttribute('src') !== src)
      phoneView.setAttribute('src', src)
    const cap = phoneFrame.querySelector('.tw-phone-cap')
    if (cap)
      cap.textContent = loadedPreset ? '390 px' : '390 px · photo par défaut : un fichier déposé ne passe pas'
  }
  phoneBtn.addEventListener('click', () => {
    phoneFrame.hidden = !phoneFrame.hidden
    phoneBtn.setAttribute('aria-pressed', String(!phoneFrame.hidden))
    syncPhone()
  })

  function startPhone() {
    panel.style.display = 'none'
    restore.style.display = 'none'
    if (PHONE) {
      loadedPreset = PHONE
      loadedName = PHONE.split('/').pop() ?? PHONE
      setImage(PHONE, loadedName)
    }
    apply(state)
    hero?.scrollIntoView({ block: 'start' })
    addEventListener('storage', (e) => {
      if (e.key !== STORAGE_KEY)
        return
      Object.assign(state, load())
      masksDirty = true
      apply(state)
    })
  }

  /* démarrage : attendre le handle si le hero n'est pas encore monté */
  function start() {
    build()
    if (PHONE !== null) {
      startPhone()
      return
    }
    apply(state)
    status()
    if (import.meta.env.DEV)
      reopenSaved()
  }

  /* after a Save, the dev server reloads the page: the photo that was saved comes back,
     with the confirmation (kept a few seconds: a content change can reload more than once) */
  function reopenSaved() {
    const raw = sessionStorage.getItem(REOPEN_KEY)
    const saved: { src?: string, done?: string, at?: number } = raw ? JSON.parse(raw) : {}
    if (!saved.at || Date.now() - saved.at > 10_000) {
      sessionStorage.removeItem(REOPEN_KEY)
      syncSave()
      return
    }
    const p = PRESETS.find(x => x.src === saved.src)
    if (p)
      loadPreset(p)
    syncSave()
    const msg = document.getElementById('tw-save-msg')
    if (msg && saved.done)
      msg.textContent = saved.done
  }
  if (hero?.spotHero)
    start()
  else
    hero?.addEventListener('spot-hero:ready', start, { once: true })
</script>

<style>
  /* Le panneau — outil de designer. Zéro arrondi, aucune ombre : il respecte la feuille
     qu'il règle. Valeurs internes en littéral (un seul composant, PIPELINE §4.7). */
  .tw-panel {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 100;
    width: 288px;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    background: var(--paper);
    border: 1px solid var(--ink);
    font-family: var(--sans);
    transition:
      transform var(--dur-base) cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity var(--dur-base) ease;
  }
  .tw-panel.tw-hidden {
    transform: translateX(calc(100% + 32px));
    opacity: 0;
    pointer-events: none;
  }
  .tw-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--ink);
    position: sticky;
    top: 0;
    background: var(--paper);
    z-index: 1;
    cursor: move;
    touch-action: none;
  }
  .tw-head .ttl {
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--ink);
  }
