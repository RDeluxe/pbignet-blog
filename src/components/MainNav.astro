---
/** les entrées vivent dans `src/data/nav.ts` : la barre index affiche les mêmes */
import { primary as items, secondary as right } from '../data/nav'

const { currentPath } = Astro.props as { currentPath?: string }
---

<nav class="main" aria-label="Navigation principale">
  {items.map(item => (
    item.locked
      ? (
          <span class="lock" aria-disabled="true" title="Section en cours de construction">
            {item.label}
          </span>
        )
      : (
          <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        )
  ))}
  <span class="sp"></span>
  {right.map(item => (
    item.locked
      ? (
          <span class="lock" aria-disabled="true" title="Section en cours de construction">
            {item.label}
          </span>
        )
      : (
          <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        )
  ))}
</nav>

<style>
  .main {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-optical-6) var(--space-xl);
    /* TODO token: 11px → --space-… ? (absent de l'échelle) */
    padding: 11px 0;
    font-family: var(--mono);
    font-size: var(--fs-data);
    /* TODO token: 0.05em → --tr-… ? (absent de l'échelle ; déjà en dur dans SiteFooter) */
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--line);
  }
  .main a {
    color: var(--ink-2);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .main a:hover,
  .main a[aria-current='page'] {
    color: var(--accent);
    border-color: var(--accent);
  }
  .sp { flex: 1; }
  .lock { color: var(--ink-3); cursor: default; }
</style>
