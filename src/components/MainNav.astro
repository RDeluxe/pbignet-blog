---
/** les entrées vivent dans `src/data/nav.ts` : la barre index affiche les mêmes */
import { primary as items, secondary as right } from '../data/nav'
import LockedItem from './LockedItem.astro'

const { currentPath } = Astro.props as { currentPath?: string }
---

<nav class="main" aria-label="Main">
  {items.map(item => (
    item.locked
      ? (
          <LockedItem label={item.label} />
        )
      : (
          <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        )
  ))}
  <span class="sp"></span>
  {right.map(item => (
    item.locked
      ? (
          <LockedItem label={item.label} />
        )
      : (
          <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        )
  ))}
</nav>

<style>
  .main {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-optical-6) var(--space-xl);
    /* TODO token: 11px → --space-… ? (absent de l'échelle) */
    padding: 11px 0;
    font-family: var(--mono);
    font-size: var(--fs-data);
    /* TODO token: 0.05em → --tr-… ? (absent de l'échelle ; déjà en dur dans SiteFooter) */
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--line);
  }
  .main a {
    position: relative;
    color: var(--ink-2);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .main a:hover,
  .main a[aria-current='page'] {
    color: var(--accent-text);
    border-color: var(--accent);
  }
  /* the link is 17px tall; its hit area grows to ~44px without moving anything
     (critique 2026-11-02, n° 26) */
  .main a::after {
    content: '';
    position: absolute;
    inset: -13px -6px;
  }
  .sp { flex: 1; }
</style>
