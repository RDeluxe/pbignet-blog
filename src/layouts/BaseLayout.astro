---
import process from 'node:process'
import RegMarks from '../components/print/RegMarks.astro'
import '../styles/index.css'
import '@fontsource/anton/400.css'
import '@fontsource/space-mono/400.css'
import '@fontsource/space-mono/700.css'
import '@fontsource-variable/archivo'
import '@fontsource-variable/newsreader'
import '@fontsource-variable/newsreader/wght-italic.css'

interface Props {
  title?: string
  description?: string
  /** pages de design system : hors index, hors sitemap */
  noindex?: boolean
  /**
   * L'encre unique de la page — mobilier + type (NORTHSTAR §05, « one ink per page »).
   * `olive` = l'index, `sepia` = les articles. Le dither photographique n'est PAS lié à ce
   * choix : il peut être keyé à l'image.
   */
  ink?: 'olive' | 'sepia'
  /** the page in every language it exists in, itself included: `<link rel=alternate hreflang>` */
  alternates?: { lang: 'en' | 'fr', href: string }[]
}

const {
  title = 'exhale — Pierrick Bignet',
  // reprise telle quelle de 01_Home.html (gold) : le copy du site est en anglais
  description = 'The personal index of Pierrick Bignet — engineer, game art director, and photographer. Short essays, field notes, and dithered 35mm photography.',
  noindex = false,
  ink = 'olive',
  alternates = [],
} = Astro.props

// Umami (stats.pierrickbignet.com): the production build only. Not dev, not the staging
// build (BUILD_TARGET=staging), not the CD export (CD_EXPORT=1). No cookie, no banner.
const umami = import.meta.env.PROD
  && process.env.BUILD_TARGET !== 'staging'
  && process.env.CD_EXPORT !== '1'

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href
---

<!doctype html>
<!-- the site's chrome is English; a French post says so on its own <article> (n° 24) -->
<html lang="en" data-ink={ink}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map(a => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site ?? Astro.url).href} />)}
    {/* the reader's language, before the first paint: their choice, else the browser's
        (fr* → fr), else English. Lists show it (base.css), the Masthead sets it. */}
    <script is:inline>
      (() => {
        let l
        try {
          l = localStorage.getItem('lang')
        }
        catch {}
        if (l !== 'en' && l !== 'fr')
          l = (navigator.language || '').toLowerCase().startsWith('fr') ? 'fr' : 'en'
        document.documentElement.dataset.lang = l
      })()
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="exhale" href="/rss.xml" />
    <title>{title}</title>
    {umami && <script is:inline defer src="https://stats.pierrickbignet.com/lib.js" data-website-id="cfc6adbb-279b-42d1-a75e-8d6aca910631" data-domains="blog.pierrickbignet.com"></script>}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="exhale" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <canvas class="topo-layer" id="topo" aria-hidden="true"></canvas>
    <div class="grain-layer" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>
    <RegMarks />

    <div class="page">
      <slot />
    </div>

    <script>
      import { Grain, Topo } from '../scripts/texture.ts'

      Grain.apply(20)

      const canvas = document.getElementById('topo') as HTMLCanvasElement
      const color = getComputedStyle(document.documentElement)
        .getPropertyValue('--topo')
        .trim() || 'rgba(61,73,29,0.06)'

      Topo.mount(canvas, {
        color,
        levels: 16,
        cell: 24,
        scale: 0.0019,
        seed: 11,
        emphasizeEvery: 4,
      })
    </script>
  </body>
</html>
