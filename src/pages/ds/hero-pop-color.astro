---
/**
 * Preview du composant HeroPopColor — deux recipes côte à côte pour juger le pattern.
 * Ces pages `ds/` servent à valider un composant et deviendront les `*.card.html`
 * poussées vers le projet Design System (cf. PIPELINE §6). Elles sont `noindex`.
 */
import SpotTweaks from '../../components/ds/SpotTweaks.astro'
import HeroPopColor from '../../components/hero/HeroPopColor.astro'
import Section from '../../components/primitives/Section.astro'
import MonoLabel from '../../components/print/MonoLabel.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="HeroPopColor — exhale DS" noindex>
  <Section as="header" rhythm="none">
    <MonoLabel>DS · Cover · HeroPopColor</MonoLabel>
  </Section>

  <Section rhythm="none">
    <MonoLabel tone="quiet">
      ⚠ La source doit être une photo EN COULEUR, jamais un PNG déjà dithéré : le moteur
      sélectionne par teinte, donc une image monochrome ne fait rien popper.
    </MonoLabel>
  </Section>

  <!-- recipe 1 : le pont rouge — la référence du banc `Article - spot colour` -->
  <HeroPopColor
    photo={{
      src: '/photos/source/bridge-red-web.jpg',
      alt: 'Pont suspendu cramoisi au-dessus de la vallée de la Shimanto, seule couleur d’une scène grise',
    }}
    kicker="Field Note · One red thing"
    title="Shimanto"
    place="Crimson span"
    method="KŌCHI · iPHONE 13 · SPOT COLOUR ON DITHERED GROUND · ⓒ P. BIGNET"
    vcap="FIELD NOTE / ONE RED THING"
    titleY="11%"
    spot={{
      keepColor: '#c8321e',
      ink: [20, 22, 15],
      paper: [74, 78, 62],
      contrast: 1.3,
      brightness: -0.02,
      hueLo: 34,
      hueSpan: 62,
      satBoost: 0.35,
    }}
  />

  <Section>
    <MonoLabel tone="quiet">
      Recipe 01 — keepColor #c8321e · ground 20,22,15 / 74,78,62 · titre à 11%
    </MonoLabel>
  </Section>

  <!-- recipe 2 : la sélection n'est pas limitée au rouge — ici c'est le ciel qui reste,
       sur une grande surface, avec un titre placé bas et un point focal descendu. -->
  <HeroPopColor
    photo={{
      src: '/photos/source/castle-blue-web.jpg',
      alt: 'Toitures du château de Matsuyama sous un grand ciel bleu',
    }}
    title="Matsuyama"
    place="Matsuyama-jō"
    method="IYO · iPHONE 13 · SPOT COLOUR ON DITHERED GROUND · ⓒ P. BIGNET"
    titleY="56%"
    titleYMobile="60%"
    cue={false}
    height="min(72vh, 700px)"
    focal={{ x: 0.5, y: 0.64 }}
    spot={{
      keepColor: '#3d6ea8',
      ink: [20, 24, 30],
      paper: [78, 82, 74],
      contrast: 1.22,
      brightness: 0.02,
      hueLo: 28,
      hueSpan: 58,
      satBoost: 0.4,
    }}
  />

  <!-- recipe 3 : les options opt-in (mode teinte, fond photo, zones) — repris de l'outil de
       trame du carrousel. Le bordeaux est isolé par l'ANGLE de teinte, puis restreint à deux
       polygones `in` : le reste de la photo retombe dans le fond dithéré. -->
  <HeroPopColor
    photo={{
      src: '/photos/source/trame-zones-web.jpg',
      alt: 'Combi bordeaux dans une rue, seule couleur d’une scène dithérée',
    }}
    title="Combi"
    place="Hue + zones"
    method="MODE TEINTE · FOND PHOTO · ZONES `IN` · ⓒ P. BIGNET"
    titleY="56%"
    cue={false}
    spot={{
      keepColor: '#81222c',
      ink: [24, 23, 15],
      paper: [211, 204, 182],
      cell: 2,
      contrast: 1.5,
      brightness: 0.08,
      satBoost: 0.35,
      hueMode: true,
      hueTol: 28,
      hueSoft: 12,
      satMin: 58,
      satSoft: 20,
      ground: 'photo',
      groundMix: 0.4,
      groundSat: 1.15,
      groundLift: 0.04,
      masks: [
        { mode: 'in', pts: [[0.264, 0.117], [0.736, 0.119], [0.706, 0.64], [0.516, 0.622], [0.457, 0.537], [0.272, 0.518]] },
        { mode: 'in', pts: [[0.594, 0.632], [0.597, 0.708], [0.608, 0.734], [0.633, 0.732], [0.636, 0.752], [0.665, 0.791], [0.674, 0.781], [0.668, 0.638]] },
      ],
    }}
  />

  <Section>
    <MonoLabel tone="quiet">
      Recipe 03 — hueMode (angle 28° + 12°, saturation ≥ 58) · ground photo (mix 0.4) · deux
      zones `in`. Le panneau T pilote la première cover : y charger « zones demo » pour dessiner.
    </MonoLabel>
  </Section>

  {/* le panneau de réglages (touche T) pilote la PREMIÈRE cover de la page —
      porté de l'atelier OD le 2026-08-05, il sort la recipe en syntaxe de props */}
  <SpotTweaks />

  <Section>
    <MonoLabel tone="quiet">
      Recipe 02 — keepColor #3d6ea8 (grande surface : le ciel) · titre sous le ciel,
      56% / 60% en étroit · focal 0.64 · sans cue.
      Le ground est resté sombre (78,82,74) parce que c'est LUI qui plafonne le contraste du
      titre : un premier essai à 128,132,122 tombait à 2.28:1 en étroit.
    </MonoLabel>
  </Section>
</BaseLayout>
