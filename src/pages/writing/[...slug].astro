---
import type { GetStaticPaths } from 'astro'
import { getCollection, render } from 'astro:content'
import ArticleBar from '../../components/article/ArticleBar.astro'
import ArticleFoot from '../../components/article/ArticleFoot.astro'
import ArticleHead from '../../components/article/ArticleHead.astro'
import LangSwitch from '../../components/article/LangSwitch.astro'
import CoverSlot from '../../components/hero/CoverSlot.astro'
import Masthead from '../../components/Masthead.astro'
import Prose from '../../components/primitives/Prose.astro'
import Section from '../../components/primitives/Section.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatMonth } from '../../lib/date'
import { opensOnText } from '../../lib/posts'

export const getStaticPaths: GetStaticPaths = async () => {
  // a draft's page exists in `pnpm dev` only: out of the build, so out of the sitemap
  const posts = await getCollection('writing', p => import.meta.env.DEV || !p.data.draft)
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, translation: posts.find(p => p.id === post.data.translation) },
  }))
}

const { post, translation } = Astro.props
const { Content } = await render(post)
const d = post.data

const month = formatMonth(d.pubDate)

// a translated post: both versions, English first, for the switch and the hreflang links
const versions = (translation ? [post, translation] : [])
  .map(p => ({ lang: p.data.lang, href: `/writing/${p.id}/` }))
  .sort((a, b) => (a.lang === 'en' ? -1 : b.lang === 'en' ? 1 : 0))

const stats = [
  { key: 'Reading', value: `${d.readTime} MIN`, accent: true },
  { key: 'Date', value: month },
  ...(d.series ? [{ key: 'Series', value: d.series.toUpperCase() }] : []),
  ...(d.place ? [{ key: 'Place', value: d.place.toUpperCase() }] : []),
  ...(d.edition ? [{ key: 'Edition', value: d.edition }] : []),
]
---

{/* les articles roulent en sépia : une encre par page, mobilier + type (NORTHSTAR §05) */}
<BaseLayout title={`${d.title} — exhale`} description={d.dek ?? d.description} ink="sepia" alternates={versions}>
  {/* the masthead opens the page like everywhere; the reading bar takes over once it is gone */}
  <Section as="header" rhythm="none">
    <Masthead currentPath="/writing" />
  </Section>
  <ArticleBar title={d.title} overCover={!!d.cover} lang={d.lang} />

  <article lang={d.lang}>
    {d.cover && <CoverSlot cover={d.cover} fallbackTitle={d.title} />}

    <ArticleHead
      tag={d.tag}
      tags={d.tags}
      stats={stats}
      title={d.title}
      dek={d.dek}
    >
      {versions.length > 1 && <LangSwitch versions={versions} current={d.lang} />}
    </ArticleHead>

    <Prose numbered={d.numbered} dropCap={opensOnText(post.body)}>
      <Content />
    </Prose>

    <ArticleFoot post={post} />
  </article>

  <SiteFooter />
</BaseLayout>
