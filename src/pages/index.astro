---
import { getCollection } from 'astro:content'
import CollCard from '../components/CollCard.astro'
import FeaturedEssay from '../components/FeaturedEssay.astro'
import GearCard from '../components/GearCard.astro'
import Hero from '../components/Hero.astro'
import IndexBar from '../components/IndexBar.astro'
import MainNav from '../components/MainNav.astro'
import Metabar from '../components/Metabar.astro'
import PhotoFrame from '../components/PhotoFrame.astro'
import PostRow from '../components/PostRow.astro'
import Grid from '../components/primitives/Grid.astro'
import Lede from '../components/primitives/Lede.astro'
import Section from '../components/primitives/Section.astro'
import Stack from '../components/primitives/Stack.astro'
import SectionHead from '../components/SectionHead.astro'
import SiteFooter from '../components/SiteFooter.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const allPosts = await getCollection('writing')
const posts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4)

const allGuides = await getCollection('guides')

const gear = [
  { number: 'SET·01', name: 'The Desk', meta: 'Linux · 2×27" · split kbd', href: '/setup#desk' },
  { number: 'SET·02', name: 'Camera Bag', meta: 'Contax T2 · X100V', href: '/setup#camera' },
  { number: 'SET·03', name: 'Software', meta: 'nvim · Figma · DaVinci', href: '/setup#software' },
  { number: 'SET·04', name: 'Home Lab', meta: '12TB · self-hosted', href: '/setup#homelab' },
]

const photos = [
  { src: '/photos/street-dither.png', alt: 'Tokyo backstreet', caption: 'Tokyo · sakura', number: '№012', ratio: 'tall' as const },
  { src: '/photos/fuji-dither.png', alt: 'Kawaguchiko, Fuji', caption: 'Kawaguchiko', number: '№001', ratio: 'wide' as const },
  { src: '/photos/torii-red.png', alt: 'Torii, Miyajima', caption: 'Miyajima', number: '№014', ratio: 'wide' as const },
]
---

<BaseLayout>
  <IndexBar />

  <Section as="header" rhythm="none">
    <Metabar />
    <MainNav currentPath="/" />
    <Lede size="intro" spaced>
      I build software, direct the art of games, and photograph everything in between.
    </Lede>
    <Hero photoSrc="/photos/arc-cdither.png" />
  </Section>

  <main>
    <Section>
      <SectionHead title="Writing" meta="[ OPINIONS · NOTES ]" />
      <Lede measure="tight">
        Short essays and unfiled opinions: taste, building things, and the gap between.
      </Lede>
      <Stack spaced>
        {posts.map((post, i) => (
          <PostRow
            index={String(i + 1).padStart(3, '0')}
            tag={post.data.tag}
            tagAccent={post.data.tag === 'Essay'}
            title={post.data.title}
            description={post.data.description}
            readTime={post.data.readTime}
            pubDate={post.data.pubDate}
            href={`/writing/${post.id}`}
            lang={post.data.lang}
          />
        ))}
      </Stack>
    </Section>

    <Section>
      <SectionHead title="Latest&nbsp;Field&nbsp;Note" meta="[ PHOTO-ESSAY · TRAVEL ]" />
    </Section>
    <FeaturedEssay
      number="014"
      location="Itsukushima, Miyajima"
      src="/photos/torii-red.png"
      alt="Itsukushima torii, riso dither"
      word="torii"
      shotOn="X100V"
      readTime="09"
      href="/writing/miyajima"
    />

    <Section>
      <SectionHead title="Field&nbsp;Guides" />
      <Grid cols={3} gap="hairline">
        {allGuides.map(guide => (
          <CollCard
            tag={guide.data.tag}
            tagAccent={guide.data.tag === 'Guide'}
            title={guide.data.title}
            description={guide.data.description}
            footer={guide.data.chapters}
            href={`/guides/${guide.id}`}
            bordered={false}
          />
        ))}
      </Grid>
    </Section>

    <Section>
      <SectionHead title="Photographs" meta="[ 35MM · DITHERED · 2024–26 ]" />
      <Grid cols={3} lead>
        {photos.map(p => (
          <PhotoFrame
            src={p.src}
            alt={p.alt}
            caption={p.caption}
            number={p.number}
            ratio={p.ratio}
          />
        ))}
      </Grid>
    </Section>

    <Section>
      <SectionHead title="The&nbsp;Setup" />
      <Grid cols={4}>
        {gear.map(g => (
          <GearCard
            number={g.number}
            name={g.name}
            meta={g.meta}
            href={g.href}
          />
        ))}
      </Grid>
    </Section>
  </main>

  <SiteFooter />
</BaseLayout>
