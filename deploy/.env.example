# Variables de la stack `blog-prod` dans Dockhand (jamais de .env commité).
# Posées par Dockhand (côté serveur) :
TRAEFIK_NETWORK=web_blog
# Posées par l'app :
PUBLIC_HOST=blog.pierrickbignet.com
IMAGE_REPO=ghcr.io/rdeluxe/pbignet-blog
# `latest` suffit : la CI pousse aussi sha-<court> pour retrouver une version
IMAGE_TAG=latest
